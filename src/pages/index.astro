---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://global-tools.pages.dev';
const canonical = `${siteUrl}/`;

const defaultLang = 'en';
---

<Layout
  title="ToolAtlas — Free Online Tools"
  description="Free online tools for images, PDFs, developers, text, QR codes, testing, colors, and everyday digital tasks."
  lang={defaultLang}
  canonical={canonical}
>
  <main class="page">
    <section class="hero">
      <p class="eyebrow">TOOLATLAS</p>

      <h1>Free online tools for everyday tasks.</h1>

      <p>
        Fast, simple browser-based tools for images, PDFs, developers, text,
        testing, QR codes, colors, and more.
      </p>

      <div class="actions">
        <a href="/en/" class="primary">Explore tools</a>
        <a href="/en/tools/" class="secondary">View all tools</a>
      </div>
    </section>

    <section class="languages" aria-labelledby="languages-title">
      <h2 id="languages-title">Choose your language</h2>

      <div class="language-grid">
        <a href="/en/">English</a>
        <a href="/es/">Español</a>
        <a href="/fr/">Français</a>
        <a href="/de/">Deutsch</a>
        <a href="/it/">Italiano</a>
        <a href="/pt/">Português</a>
        <a href="/ar/">العربية</a>
        <a href="/tr/">Türkçe</a>
        <a href="/hi/">हिन्दी</a>
        <a href="/ja/">日本語</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 90px 0;
  }

  .hero {
    max-width: 820px;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(46px, 8vw, 82px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .hero > p:not(.eyebrow) {
    max-width: 720px;
    margin: 26px 0 0;
    color: #667085;
    font-size: 19px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    background: #101828;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d0d5dd;
    color: #101828;
    background: #fff;
  }

  .languages {
    margin-top: 90px;
  }

  .languages h2 {
    margin: 0 0 20px;
    font-size: 28px;
    letter-spacing: -0.04em;
  }

  .language-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .language-grid a {
    padding: 18px;
    border: 1px solid #e4e7ec;
    border-radius: 14px;
    color: #101828;
    background: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .language-grid a:hover {
    background: #f8fafc;
  }

  @media (max-width: 800px) {
    .page {
      width: min(100% - 28px, 1100px);
      padding: 60px 0 70px;
    }

    .language-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 44px;
    }

    .language-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
