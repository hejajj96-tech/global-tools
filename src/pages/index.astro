---
import Layout from '../layouts/Layout.astro';
import { SITE_URL, LANGUAGES } from '../data/site';
import { tools } from '../data/tools';
import { categoriesData } from '../data/categories';
import { languages } from '../data/i18n';

const canonical = `${SITE_URL}/`;
const defaultLang = 'en';
---

<Layout
  title="ToolAtlas — Free, Private Online Tools"
  description="Free online tools for images, PDFs, developer utilities, text manipulation, QR codes, testing, and digital productivity. Fast, client-side, and privacy-first."
  lang={defaultLang}
  canonical={canonical}
>
  <div class="page">
    <section class="hero">
      <div class="badge">FREE · NO SIGNUP · PRIVACY-FIRST</div>

      <h1>
        Free online tools.<br />
        <span>Fast, private, and browser-first.</span>
      </h1>

      <p class="hero-desc">
        ToolAtlas provides high-performance utilities for image compression, PDF editing, code formatting, QR codes, and hardware benchmarking. All processing executes securely in your browser memory.
      </p>

      <div class="actions">
        <a href="/en/tools/" class="btn primary">Explore all tools</a>
        <a href="/en/categories/" class="btn secondary">Browse categories</a>
        <a href="/en/guides/" class="btn secondary">Read guides</a>
      </div>
    </section>

    <section class="languages-section" aria-labelledby="languages-title">
      <div class="section-head">
        <h2 id="languages-title">Choose your language</h2>
        <p>ToolAtlas is fully localized in 10 languages with identical client-side speed and privacy.</p>
      </div>

      <div class="language-grid">
        {
          LANGUAGES.map((code) => {
            const loc = languages[code];
            return (
              <a href={`/${code}/`} class="lang-card">
                <span class="lang-tag">{code.toUpperCase()}</span>
                <strong>{loc.label}</strong>
                <small>{loc.homeSubtitle}</small>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="section" aria-labelledby="categories-title">
      <div class="section-head">
        <h2 id="categories-title">Explore by category</h2>
        <p>Discover specialized tool suites built for everyday digital workflows.</p>
      </div>

      <div class="category-grid">
        {
          categoriesData.map((cat) => {
            const catTools = tools.filter((t) => t.category === cat.name);
            return (
              <a href={`/en/categories/${cat.slug}/`} class="cat-card">
                <div class="cat-icon">{cat.icon}</div>
                <div class="cat-info">
                  <h3>{cat.name}</h3>
                  <p>{cat.description}</p>
                  <span class="count">{catTools.length} tools →</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="section" aria-labelledby="featured-title">
      <div class="section-head">
        <h2 id="featured-title">Popular online utilities</h2>
        <p>Instant browser tools ready to use with zero installations or downloads.</p>
      </div>

      <div class="tools-grid">
        {
          tools.slice(0, 12).map((tool) => (
            <a href={`/en/tools/${tool.slug}/`} class="tool-card">
              <span class="tool-icon">{tool.icon}</span>
              <div class="tool-info">
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                <em>{tool.category}</em>
              </div>
              <span class="arrow">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="trust-banner">
      <div class="trust-grid">
        <div class="trust-card">
          <span class="trust-icon">⚡</span>
          <h3>Zero Latency Processing</h3>
          <p>Tools execute directly on your CPU/GPU using modern WebAssembly and HTML5 Canvas APIs.</p>
        </div>
        <div class="trust-card">
          <span class="trust-icon">🔒</span>
          <h3>Complete Data Privacy</h3>
          <p>Files, passwords, and JSON payloads never touch a remote server. Your data stays on your machine.</p>
        </div>
        <div class="trust-card">
          <span class="trust-icon">∞</span>
          <h3>100% Free Forever</h3>
          <p>No subscriptions, no rate limits, and no account registrations required.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 60px 0 90px;
  }

  .hero {
    max-width: 860px;
    margin-bottom: 70px;
  }

  .badge {
    display: inline-flex;
    padding: 6px 13px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 20px 0 0;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: #ffffff;
  }

  h1 span {
    color: #94a3b8;
  }

  .hero-desc {
    max-width: 720px;
    margin: 24px 0 0;
    color: #aab4c5;
    font-size: 19px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 750;
    font-size: 15px;
    transition: all 0.2s ease;
  }

  .primary {
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(34, 211, 238, 0.22);
  }

  .primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(34, 211, 238, 0.32);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .secondary:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(34, 211, 238, 0.35);
  }

  .section {
    margin-top: 75px;
  }

  .section-head {
    margin-bottom: 28px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 32px;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .section-head p {
    margin: 8px 0 0;
    color: #94a3b8;
    font-size: 16px;
  }

  .languages-section {
    margin-top: 60px;
    padding: 34px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.02);
  }

  .language-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 20px;
  }

  .lang-card {
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .lang-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .lang-tag {
    font-size: 11px;
    font-weight: 800;
    color: #22d3ee;
    letter-spacing: 0.1em;
  }

  .lang-card strong {
    font-size: 16px;
  }

  .lang-card small {
    color: #8d93aa;
    font-size: 12px;
    line-height: 1.4;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .cat-card {
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: all 0.2s ease;
  }

  .cat-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .cat-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(99, 102, 241, 0.2));
    border: 1px solid rgba(34, 211, 238, 0.25);
    font-size: 20px;
  }

  .cat-info h3 {
    margin: 0;
    font-size: 18px;
  }

  .cat-info p {
    margin: 8px 0 12px;
    color: #8d93aa;
    font-size: 13px;
    line-height: 1.5;
  }

  .cat-info .count {
    color: #22d3ee;
    font-size: 13px;
    font-weight: 700;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .tool-card {
    display: grid;
    grid-template-columns: 46px 1fr 16px;
    gap: 14px;
    align-items: center;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .tool-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .tool-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #111426;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 800;
    color: #22d3ee;
  }

  .tool-info h3 {
    margin: 0;
    font-size: 16px;
    color: #ffffff;
  }

  .tool-info p {
    margin: 4px 0 0;
    color: #8d93aa;
    font-size: 13px;
    line-height: 1.4;
  }

  .tool-info em {
    display: inline-block;
    margin-top: 6px;
    color: #22d3ee;
    font-size: 11px;
    font-style: normal;
  }

  .arrow {
    color: #6366f1;
    font-weight: 800;
  }

  .trust-banner {
    margin-top: 80px;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(18, 21, 38, 0.5);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .trust-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .trust-icon {
    font-size: 28px;
  }

  .trust-card h3 {
    margin: 0;
    font-size: 19px;
    color: #ffffff;
  }

  .trust-card p {
    margin: 0;
    color: #8d93aa;
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .language-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .page {
      padding: 40px 0 60px;
    }
    .language-grid {
      grid-template-columns: 1fr;
    }
    .category-grid {
      grid-template-columns: 1fr;
    }
    .tools-grid {
      grid-template-columns: 1fr;
    }
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
