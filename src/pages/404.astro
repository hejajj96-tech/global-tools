---
import Layout from '../layouts/Layout.astro';
import { SITE_URL } from '../data/site';

const canonical = `${SITE_URL}/404.html`;
---

<Layout
  title="Page Not Found (404) — ToolAtlas"
  description="The requested page could not be found on ToolAtlas."
  lang="en"
  canonical={canonical}
  noindex={true}
>
  <div class="page">
    <div class="error-card">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p>
        The page or tool you are looking for doesn't exist or may have been relocated.
        Explore our free online utilities below.
      </p>

      <div class="actions">
        <a href="/en/" class="btn primary">Return to Home</a>
        <a href="/en/tools/" class="btn secondary">Browse All Tools</a>
        <a href="/en/categories/" class="btn secondary">Browse Categories</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    width: min(800px, calc(100% - 32px));
    margin: 0 auto;
    padding: 90px 0 120px;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .error-card {
    padding: 50px 30px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(18, 21, 38, 0.45);
  }

  .error-code {
    display: inline-block;
    font-size: 84px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.06em;
    background: linear-gradient(135deg, #22d3ee, #6366f1, #a855f7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 {
    margin: 16px 0 0;
    font-size: 32px;
    color: #ffffff;
  }

  p {
    max-width: 520px;
    margin: 16px auto 0;
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 750;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .primary {
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: #ffffff;
  }

  .primary:hover {
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .secondary:hover {
    background: rgba(255, 255, 255, 0.08);
  }
</style>
