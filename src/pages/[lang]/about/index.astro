---
import Layout from '../../../layouts/Layout.astro'; import {languages,langCodes} from '../../../data/i18n'; export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props; const i=languages[lang];
---
<Layout title={`About ToolAtlas`} description="About ToolAtlas and its browser-first online tools." lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/about/`}><main class="doc"><h1>{i.about}</h1><p>ToolAtlas is a global collection of focused online utilities for everyday work. We aim to make common tasks fast, understandable and accessible without unnecessary registration.</p><h2>Privacy-first approach</h2><p>Where possible, tools process files locally in the browser. This reduces uploads and keeps workflows lightweight.</p><h2>Quality</h2><p>Each tool is designed around a specific user task, with clear instructions, accessible controls and responsive layouts.</p></main></Layout><style>.doc{max-width:760px;margin:auto;padding:70px 22px;line-height:1.8}.doc h1{font-size:52px;letter-spacing:-.06em}.doc h2{margin-top:40px}.doc p{color:#667085}</style>
