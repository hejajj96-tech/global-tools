---
import Layout from '../../../layouts/Layout.astro';
import { SITE_URL } from '../../../data/site';
import { langCodes, getLocale } from '../../../data/i18n';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const loc = getLocale(lang);
const canonical = `${SITE_URL}/${lang}/about/`;

const breadcrumbs = [
  { name: loc.breadcrumbHome, url: `/${lang}/` },
  { name: loc.about, url: `/${lang}/about/` },
];
---

<Layout
  title={`${loc.about} — ToolAtlas`}
  description={`${loc.about}: ${loc.homeLead}`}
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{loc.breadcrumbHome}</a>
      <span>›</span>
      <strong>{loc.about}</strong>
    </nav>

    <header class="hero">
      <div class="badge">{loc.about.toUpperCase()}</div>
      <h1>{loc.homeTitle}</h1>
      <p class="hero-desc">
        {loc.homeLead}
      </p>
    </header>

    <div class="content-body">
      <section class="section-card">
        <h2>Our Mission</h2>
        <p>
          The modern web is filled with utility websites that force users through multi-step paywalls, invasive account registrations, and intrusive ads that cover the screen. Worse, many services upload sensitive documents and photos to unknown third-party cloud servers without clear retention disclosures.
        </p>
        <p>
          ToolAtlas eliminates these friction points. We build high-performance, single-purpose utilities that load instantly and execute directly in your browser sandbox.
        </p>
      </section>

      <section class="section-card">
        <h2>The Browser-First Architecture</h2>
        <p>
          Whenever technically feasible, ToolAtlas relies on modern web standards—such as the HTML5 Canvas API, WebAssembly (Wasm), the Web Crypto API, and JavaScript typed arrays—to perform computations locally on your machine.
        </p>
        <div class="architecture-grid">
          <div class="arch-item">
            <span class="arch-icon">🛡</span>
            <h3>Zero Server Uploads</h3>
            <p>Your PDF contracts, images, JSON payloads, and passwords never leave your browser memory.</p>
          </div>
          <div class="arch-item">
            <span class="arch-icon">⚡</span>
            <h3>Hardware Acceleration</h3>
            <p>Tasks run with native CPU/GPU performance without network latency or queuing delays.</p>
          </div>
          <div class="arch-item">
            <span class="arch-icon">📱</span>
            <h3>Universal Compatibility</h3>
            <p>Designed with responsive CSS that adapts seamlessly across phones, tablets, and desktop workstations.</p>
          </div>
        </div>
      </section>

      <section class="section-card">
        <h2>Global Availability & Localization</h2>
        <p>
          We believe utility tools should be accessible to everyone worldwide regardless of language. ToolAtlas provides full interface localization across 10 global languages: English, Spanish, French, German, Italian, Portuguese, Arabic (with full right-to-left layout), Turkish, Hindi, and Japanese.
        </p>
      </section>

      <section class="section-card">
        <h2>Continuous Improvement</h2>
        <p>
          ToolAtlas is actively developed and maintained. We monitor Core Web Vitals, browser API deprecations, and user feedback to ensure every tool remains fast, reliable, and secure.
        </p>
        <div class="cta-row">
          <a href={`/${lang}/tools/`} class="btn primary">Explore all tools →</a>
          <a href={`/${lang}/contact/`} class="btn secondary">Get in touch</a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page {
    width: min(900px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 90px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #22d3ee;
  }

  .hero {
    margin-bottom: 50px;
  }

  .badge {
    display: inline-flex;
    padding: 5px 12px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 16px 0 0;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .hero-desc {
    margin: 20px 0 0;
    color: #aab4c5;
    font-size: 18px;
    line-height: 1.7;
  }

  .content-body {
    display: grid;
    gap: 28px;
  }

  .section-card {
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.025);
  }

  .section-card h2 {
    margin: 0 0 16px;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .section-card p {
    margin: 0 0 16px;
    color: #aab4c5;
    font-size: 16px;
    line-height: 1.75;
  }

  .section-card p:last-child {
    margin-bottom: 0;
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .arch-item {
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
  }

  .arch-icon {
    font-size: 24px;
  }

  .arch-item h3 {
    margin: 10px 0 6px;
    font-size: 16px;
    color: #ffffff;
  }

  .arch-item p {
    margin: 0;
    font-size: 13px;
    color: #8d93aa;
    line-height: 1.5;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    margin-top: 24px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 750;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .primary {
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: #ffffff;
  }

  .primary:hover {
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .secondary:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 760px) {
    .architecture-grid {
      grid-template-columns: 1fr;
    }
    .cta-row {
      flex-direction: column;
    }
    .section-card {
      padding: 22px;
    }
  }
</style>
