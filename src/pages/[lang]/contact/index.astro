---
import Layout from '../../../layouts/Layout.astro';
import { langCodes } from '../../../data/i18n';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const siteUrl = 'https://global-tools.pages.dev';
const canonical = `${siteUrl}/${lang}/contact/`;
---

<Layout
  title="Contact — ToolAtlas"
  description="Contact ToolAtlas for support, feedback, or privacy requests."
  lang={lang}
  canonical={canonical}
>
  <main class="doc">
    <h1>Contact</h1>

    <p>
      For support, feedback, or privacy requests, please use the contact
      information provided below.
    </p>

    <div class="panel">
      <strong>Support</strong>
      <p>
        Email address will be published here before the website's public
        launch.
      </p>
    </div>
  </main>
</Layout>

<style>
  .doc {
    max-width: 760px;
    margin: 0 auto;
    padding: 70px 22px;
    line-height: 1.8;
  }

  .doc h1 {
    font-size: 52px;
    letter-spacing: -0.06em;
  }

  .doc p {
    color: #667085;
  }

  .panel {
    padding: 20px;
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 15px;
  }

  @media (max-width: 640px) {
    .doc {
      padding: 44px 18px;
    }

    .doc h1 {
      font-size: 38px;
    }
  }
</style>
