---
import Layout from '../../../layouts/Layout.astro'; import {langCodes} from '../../../data/i18n'; export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props;
---
<Layout title="Contact — ToolAtlas" description="Contact ToolAtlas." lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/contact/`}><main class="doc"><h1>Contact</h1><p>For support, feedback or privacy requests, replace this page with your real support email and contact workflow before production launch.</p><div class="panel">support@YOUR-DOMAIN.com</div></main></Layout><style>.doc{max-width:760px;margin:auto;padding:70px 22px;line-height:1.8}.doc h1{font-size:52px;letter-spacing:-.06em}.doc p{color:#667085}.panel{padding:20px;background:#fff;border:1px solid #e4e7ec;border-radius:15px}</style>
