---
import Layout from '../../../layouts/Layout.astro';
import { langCodes } from '../../../data/i18n';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const siteUrl = 'https://global-tools.pages.dev';
const canonical = `${siteUrl}/${lang}/terms/`;
---

<Layout
  title="Terms of Use — ToolAtlas"
  description="Terms of use for ToolAtlas free online tools and website services."
  lang={lang}
  canonical={canonical}
>
  <main class="doc">
    <header class="hero">
      <p class="eyebrow">TOOLATLAS</p>
      <h1>Terms of Use</h1>
      <p>
        Please read these terms before using ToolAtlas and its free online
        tools.
      </p>
    </header>

    <section class="content">
      <h2>Acceptance of terms</h2>

      <p>
        By accessing or using ToolAtlas, you agree to use the website and its
        tools responsibly and in accordance with these terms.
      </p>

      <h2>Use of tools</h2>

      <p>
        ToolAtlas provides browser-based tools for general informational and
        productivity purposes. You are responsible for reviewing the results
        produced by any tool before relying on them.
      </p>

      <h2>Files and data</h2>

      <p>
        Many ToolAtlas tools are designed to process files directly in your
        browser. You should avoid uploading or processing information that you
        are not authorized to use.
      </p>

      <h2>Availability</h2>

      <p>
        We aim to keep ToolAtlas available and functional, but we do not
        guarantee uninterrupted access or that every tool will always be
        available.
      </p>

      <h2>Accuracy and responsibility</h2>

      <p>
        ToolAtlas does not guarantee that results from its tools will always be
        complete, accurate, or suitable for a particular purpose. You should
        independently verify important results.
      </p>

      <h2>Changes</h2>

      <p>
        These terms may be updated when the website, tools, or applicable
        requirements change.
      </p>

      <h2>Contact</h2>

      <p>
        For questions about these terms, please use the Contact page on
        ToolAtlas.
      </p>
    </section>
  </main>
</Layout>

<style>
  .doc {
    width: min(760px, calc(100% - 40px));
    margin: 0 auto;
    padding: 70px 0 90px;
  }

  .hero {
    margin-bottom: 55px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 7vw, 64px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero > p:last-child {
    margin-top: 22px;
    color: #667085;
    font-size: 18px;
    line-height: 1.7;
  }

  .content {
    line-height: 1.8;
  }

  .content h2 {
    margin: 42px 0 12px;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  .content h2:first-child {
    margin-top: 0;
  }

  .content p {
    margin: 0;
    color: #667085;
  }

  @media (max-width: 640px) {
    .doc {
      width: min(100% - 28px, 760px);
      padding: 48px 0 70px;
    }

    h1 {
      font-size: 40px;
    }
  }
</style>
