---
import Layout from '../../../layouts/Layout.astro'; import {langCodes} from '../../../data/i18n'; export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props;
---
<Layout title="Terms of Use — ToolAtlas" description="ToolAtlas terms of use." lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/terms/`}><main class="doc"><h1>Terms of Use</h1><p>ToolAtlas provides general-purpose browser tools. You are responsible for checking outputs before relying on them for important decisions.</p><h2>Acceptable use</h2><p>Do not use the service to violate laws, rights, security controls or the privacy of others.</p><h2>Availability</h2><p>Tools are provided on an as-is basis and may change as the platform evolves.</p><h2>Before launch</h2><p>Replace this starter legal text with your jurisdiction-specific terms and real contact details.</p></main></Layout><style>.doc{max-width:760px;margin:auto;padding:70px 22px;line-height:1.8}.doc h1{font-size:52px;letter-spacing:-.06em}.doc h2{margin-top:40px}.doc p{color:#667085}</style>
