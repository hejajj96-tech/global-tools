---
import Layout from '../../../layouts/Layout.astro';
import { SITE_URL } from '../../../data/site';
import { langCodes, getLocale } from '../../../data/i18n';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const loc = getLocale(lang);
const canonical = `${SITE_URL}/${lang}/terms/`;

const breadcrumbs = [
  { name: loc.breadcrumbHome, url: `/${lang}/` },
  { name: loc.terms, url: `/${lang}/terms/` },
];
---

<Layout
  title={`${loc.terms} — ToolAtlas`}
  description={`${loc.terms} — ToolAtlas: ${loc.freeDesc}`}
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{loc.breadcrumbHome}</a>
      <span>›</span>
      <strong>{loc.terms}</strong>
    </nav>

    <header class="hero">
      <div class="badge">{loc.terms.toUpperCase()}</div>
      <h1>{loc.terms}</h1>
      <p class="last-updated">{loc.freeDesc}</p>
    </header>

    <div class="content-body">
      <section class="section-card">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By accessing or using ToolAtlas (<code>https://global-tools.hejajj96.workers.dev/</code>), you agree to be bound by these Terms of Use and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site.
        </p>
      </section>

      <section class="section-card">
        <h2>2. Permitted Use of Tools</h2>
        <p>
          ToolAtlas grants you a personal, non-exclusive, non-transferable, revocable license to access and use our browser-based utilities for personal, educational, research, and lawful commercial purposes.
        </p>
        <p>You agree not to:</p>
        <ul>
          <li>Use the services to process illegal, copyrighted, defamatory, or malicious material without authorization.</li>
          <li>Attempt to reverse engineer, disrupt, or overload the website infrastructure or circumvent network rate limits.</li>
          <li>Scrape or mirror the website in a manner that degrades service availability for other visitors.</li>
        </ul>
      </section>

      <section class="section-card">
        <h2>3. Disclaimer of Warranties</h2>
        <p>
          All tools, calculators, formatters, and converters on ToolAtlas are provided on an <strong>"as is"</strong> and <strong>"as available"</strong> basis without warranties of any kind, whether express or implied.
        </p>
        <p>
          While we strive for maximum precision, ToolAtlas does not warrant that mathematical calculations, file conversions, regex evaluations, or output documents will be error-free or suitable for any critical legal, financial, or engineering purpose. You are solely responsible for independently verifying any results before relying on them.
        </p>
      </section>

      <section class="section-card">
        <h2>4. Limitation of Liability</h2>
        <p>
          In no event shall ToolAtlas, its developers, or affiliates be liable for any direct, indirect, incidental, special, consequential, or punitive damages (including loss of data, lost profits, or business interruption) arising out of the use or inability to use the tools or materials on this website.
        </p>
      </section>

      <section class="section-card">
        <h2>5. Intellectual Property Rights</h2>
        <p>
          The interface design, graphics, branding, educational guides, and code implementations on ToolAtlas are protected by copyright and intellectual property laws. You retain full ownership and intellectual property rights to any files, images, code, or content you process through our tools.
        </p>
      </section>

      <section class="section-card">
        <h2>6. Modifications to Terms</h2>
        <p>
          ToolAtlas may revise these Terms of Use at any time without notice. By using this website, you agree to be bound by the then-current version of these Terms of Use.
        </p>
      </section>

      <section class="section-card">
        <h2>7. Contact</h2>
        <p>
          For any questions regarding these Terms of Use, please reach out via our <a href={`/${lang}/contact/`}>Contact Page</a>.
        </p>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page {
    width: min(900px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 90px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #22d3ee;
  }

  .hero {
    margin-bottom: 45px;
  }

  .badge {
    display: inline-flex;
    padding: 5px 12px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 16px 0 0;
    font-size: clamp(36px, 6vw, 54px);
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .last-updated {
    margin: 12px 0 0;
    color: #8d93aa;
    font-size: 14px;
  }

  .content-body {
    display: grid;
    gap: 24px;
  }

  .section-card {
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.025);
  }

  .section-card h2 {
    margin: 0 0 16px;
    font-size: 21px;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .section-card p {
    margin: 0 0 14px;
    color: #aab4c5;
    font-size: 15px;
    line-height: 1.75;
  }

  .section-card p:last-child {
    margin-bottom: 0;
  }

  .section-card ul {
    margin: 10px 0 16px;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }

  .section-card li {
    color: #aab4c5;
    font-size: 15px;
    line-height: 1.6;
  }

  .section-card code {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: #22d3ee;
    font-size: 13px;
  }

  .section-card a {
    color: #22d3ee;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .section-card {
      padding: 20px;
    }
  }
</style>
