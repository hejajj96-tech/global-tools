---
import Layout from '../../../layouts/Layout.astro';
import { langCodes } from '../../../data/i18n';
import { tools, categories } from '../../../data/tools';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;

const siteUrl = 'https://global-tools.pages.dev';
const canonical = `${siteUrl}/${lang}/categories/`;
---

<Layout
  title="Tool Categories — ToolAtlas"
  description="Browse free online tools by category on ToolAtlas."
  lang={lang}
  canonical={canonical}
>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">TOOLATLAS</p>

      <h1>Tool Categories</h1>

      <p>
        Explore free online tools organized by category. Find the right tool
        quickly for images, PDFs, developers, text, testing, QR codes, and more.
      </p>
    </header>

    <section class="categories">
      {categories.map((category) => {
        const categoryTools = tools.filter(
          (tool) => tool.category === category
        );

        return (
          <article class="category">
            <div class="category-header">
              <h2>{category}</h2>
              <span>{categoryTools.length} tools</span>
            </div>

            <div class="tools">
              {categoryTools.map((tool) => (
                <a href={`/${lang}/tools/${tool.slug}/`} class="tool">
                  <span class="icon">{tool.icon}</span>

                  <span class="info">
                    <strong>{tool.name}</strong>
                    <small>{tool.description}</small>
                  </span>

                  <span class="arrow">→</span>
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </section>
  </main>
</Layout>

<style>
  .page {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 70px 0 90px;
  }

  .hero {
    max-width: 780px;
    margin-bottom: 55px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 7vw, 68px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero p:last-child {
    margin-top: 22px;
    color: #667085;
    font-size: 18px;
    line-height: 1.7;
  }

  .categories {
    display: grid;
    gap: 28px;
  }

  .category {
    padding: 26px;
    border: 1px solid #e4e7ec;
    border-radius: 22px;
    background: #fff;
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .category-header h2 {
    margin: 0;
    font-size: 25px;
    letter-spacing: -0.03em;
  }

  .category-header span {
    color: #667085;
    font-size: 13px;
    white-space: nowrap;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .tool {
    display: grid;
    grid-template-columns: 42px 1fr 18px;
    gap: 12px;
    align-items: center;
    padding: 13px;
    border: 1px solid #eaecf0;
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
  }

  .tool:hover {
    background: #f8fafc;
  }

  .icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #101828;
    color: #fff;
  }

  .info {
    min-width: 0;
  }

  .info strong {
    display: block;
    font-size: 15px;
  }

  .info small {
    display: block;
    margin-top: 4px;
    color: #667085;
    font-size: 12px;
    line-height: 1.4;
  }

  .arrow {
    color: #667085;
  }

  @media (max-width: 700px) {
    .page {
      width: min(100% - 28px, 1100px);
      padding: 48px 0 70px;
    }

    .category {
      padding: 18px;
    }

    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>
