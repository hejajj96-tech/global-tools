---
import Layout from '../../../layouts/Layout.astro'; import {tools,categories} from '../../../data/tools'; import {languages,langCodes} from '../../../data/i18n';
export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props; const i=languages[lang];
---
<Layout title={`${i.categories} — ToolAtlas`} description="Browse ToolAtlas online tool categories." lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/categories/`}><main class="container"><h1>{i.categories}</h1><div class="grid">{categories.map(c=><section class="card"><h2>{c}</h2><p>{tools.filter(t=>t.category===c).map(t=><a href={`/${lang}/tools/${t.slug}/`}>{t.name} →</a>)}</p></section>)}</div></main></Layout>
<style>.container{max-width:1100px;margin:auto;padding:60px 22px}.container h1{font-size:52px;letter-spacing:-.06em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{background:#fff;border:1px solid #e4e7ec;border-radius:17px;padding:22px}.card h2{margin-top:0}.card p{display:flex;flex-direction:column;gap:9px;color:#667085}.card a:hover{color:#101828}@media(max-width:750px){.grid{grid-template-columns:1fr}}
</style>
