---
import Layout from '../../../layouts/Layout.astro';
import { SITE_URL } from '../../../data/site';
import { langCodes, getLocale } from '../../../data/i18n';
import { tools } from '../../../data/tools';
import { categoriesData } from '../../../data/categories';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const loc = getLocale(lang);
const canonical = `${SITE_URL}/${lang}/categories/`;

const breadcrumbs = [
  { name: loc.breadcrumbHome, url: `/${lang}/` },
  { name: loc.breadcrumbCategories, url: `/${lang}/categories/` },
];
---

<Layout
  title={`${loc.allCategories} — ToolAtlas`}
  description="Explore ToolAtlas free online utilities organized by category: images, PDFs, developer utilities, text manipulation, hardware tests, and security tools."
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{loc.breadcrumbHome}</a>
      <span>›</span>
      <strong>{loc.breadcrumbCategories}</strong>
    </nav>

    <header class="hero">
      <div class="badge">TOOL CATEGORIES</div>
      <h1>{loc.allCategories}</h1>
      <p>
        Explore free browser-based tools organized by workflow and technology.
        Find specialized utilities for image optimization, PDF editing, code formatting, security, and hardware testing.
      </p>
    </header>

    <div class="categories-list">
      {
        categoriesData.map((cat) => {
          const catTools = tools.filter((t) => t.categorySlug === cat.slug);
          const localizedName = loc.categoryLabels[cat.slug] || cat.name;
          const localizedDesc = loc.categoryDescriptions[cat.slug] || cat.description;

          return (
            <article class="category-card">
              <div class="card-header">
                <div class="header-left">
                  <span class="cat-icon">{cat.icon}</span>
                  <div>
                    <h2>
                      <a href={`/${lang}/categories/${cat.slug}/`}>{localizedName}</a>
                    </h2>
                    <p class="tagline">{cat.tagline}</p>
                  </div>
                </div>
                <span class="count-pill">{catTools.length} tools</span>
              </div>

              <p class="description">{localizedDesc}</p>

              <div class="tools-preview">
                {catTools.map((tool) => (
                  <a href={`/${lang}/tools/${tool.slug}/`} class="tool-chip">
                    <span class="tool-chip-icon">{tool.icon}</span>
                    <span>{tool.name}</span>
                  </a>
                ))}
              </div>

              <div class="card-footer">
                <a href={`/${lang}/categories/${cat.slug}/`} class="explore-btn">
                  Explore all {localizedName} ({catTools.length}) →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- AdSense Slot -->
    <div class="ad-slot" aria-label={loc.advertisement}>
      <span class="ad-label">{loc.advertisement}</span>
      <div class="ad-placeholder">
        <small>Ad space reserved for Google AdSense compliance</small>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 90px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #22d3ee;
  }

  .hero {
    max-width: 820px;
    margin-bottom: 48px;
  }

  .badge {
    display: inline-flex;
    padding: 5px 12px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 16px 0 0;
    font-size: clamp(38px, 6vw, 64px);
    letter-spacing: -0.05em;
    color: #ffffff;
  }

  .hero p {
    margin: 16px 0 0;
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
  }

  .categories-list {
    display: grid;
    gap: 28px;
  }

  .category-card {
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cat-icon {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(99, 102, 241, 0.2));
    border: 1px solid rgba(34, 211, 238, 0.25);
    font-size: 22px;
  }

  .card-header h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  .card-header h2 a {
    color: #ffffff;
    text-decoration: none;
  }

  .card-header h2 a:hover {
    color: #22d3ee;
  }

  .tagline {
    margin: 4px 0 0;
    color: #67e8f9;
    font-size: 13px;
    font-weight: 600;
  }

  .count-pill {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .description {
    margin: 0;
    color: #aab4c5;
    font-size: 15px;
    line-height: 1.6;
  }

  .tools-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
    text-decoration: none;
    font-size: 13px;
    font-weight: 650;
    transition: all 0.2s ease;
  }

  .tool-chip:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(34, 211, 238, 0.1);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .tool-chip-icon {
    color: #22d3ee;
    font-weight: 800;
  }

  .card-footer {
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .explore-btn {
    color: #22d3ee;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .explore-btn:hover {
    text-decoration: underline;
  }

  .ad-slot {
    margin: 60px 0 20px;
    padding: 18px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    text-align: center;
    background: rgba(255, 255, 255, 0.015);
  }

  .ad-label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
    margin-bottom: 8px;
  }

  .ad-placeholder {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
  }

  @media (max-width: 640px) {
    .page {
      padding: 24px 0 60px;
    }
    .card-header {
      flex-direction: column;
      gap: 12px;
    }
    .category-card {
      padding: 20px;
    }
  }
</style>
