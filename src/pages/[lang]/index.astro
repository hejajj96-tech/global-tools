---
import Layout from '../../layouts/Layout.astro'; import {tools,categories} from '../../data/tools'; import {languages,langCodes} from '../../data/i18n';
export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props; const i=languages[lang];
---
<Layout title={`ToolAtlas — ${i.home}`} description={i.home} lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/`}>
<main><section style="padding:80px 0 55px;background:linear-gradient(180deg,#fff,#f7f9fc)"><div class="container" style="text-align:center"><div class="pill">FREE · NO SIGNUP · PRIVACY-FIRST</div><h1>ToolAtlas<br><span>{i.home}</span></h1><p class="lead">{lang==='en'?'Compress files, work with PDFs, format code, create QR codes and test your skills — directly in your browser.':i.home}</p><a class="btn primary" href={`/${lang}/tools/`}>{i.tools}</a></div></section><section class="container" style="padding:55px 22px"><h2>{i.popular}</h2><div class="grid">{tools.slice(0,12).map(t=><a class="card" href={`/${lang}/tools/${t.slug}/`}><span class="icon">{t.icon}</span><div><h3>{t.name}</h3><p>{t.description}</p></div><span>→</span></a>)}</div></section><section style="background:#fff;border-block:1px solid #eaecf0"><div class="container" style="padding:55px 22px"><h2>{i.categories}</h2><div class="cats">{categories.map(c=><a class="cat" href={`/${lang}/categories/`}><b>{c}</b><span>{tools.filter(t=>t.category===c).length} tools →</span></a>)}</div></div></section><section class="container" style="padding:55px 22px"><div class="panel" style="padding:32px"><h2>{i.why}</h2><div class="features"><div><b>⚡ {i.free}</b><p class="muted">Simple browser-first tools with no account required.</p></div><div><b>🔒 {i.private}</b><p class="muted">Files stay on your device for supported operations.</p></div><div><b>📱 {i.mobile}</b><p class="muted">Designed to work cleanly on phones, tablets and desktops.</p></div></div></div></section></main>
</Layout>
<style>.pill{display:inline-flex;padding:7px 11px;border:1px solid #e4e7ec;border-radius:999px;background:#fff;font-size:12px;font-weight:800}.container{max-width:1180px;margin:auto}.lead{max-width:680px;margin:0 auto 28px;color:#667085;font-size:18px;line-height:1.6}.container h2{font-size:32px;letter-spacing:-.04em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{display:grid;grid-template-columns:46px 1fr 15px;gap:13px;padding:17px;background:#fff;border:1px solid #e4e7ec;border-radius:16px}.card:hover{transform:translateY(-2px)}.icon{width:46px;height:46px;background:#101828;color:#fff;border-radius:12px;display:grid;place-items:center;font-weight:800}.card h3{margin:2px 0 5px;font-size:16px}.card p{margin:0;color:#667085;font-size:13px;line-height:1.5}.cats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.cat{padding:20px;background:#f8fafc;border:1px solid #eaecf0;border-radius:15px;display:flex;flex-direction:column;gap:8px}.cat span{color:#667085;font-size:13px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.features p{line-height:1.6}@media(max-width:800px){.grid,.features{grid-template-columns:1fr}.cats{grid-template-columns:1fr 1fr}}
</style>
