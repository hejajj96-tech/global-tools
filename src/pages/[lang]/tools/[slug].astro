              '<p class="error">Choose a PDF file first.</p>';
            return;
          }

          try {
            const module =
              await import(
                'https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/+esm'
              );

            const {
              PDFDocument,
              degrees,
            } = module;

            if (mode === 'merge-pdf') {
              const outputPdf =
                await PDFDocument.create();

              for (const file of files) {
                const bytes =
                  await file.arrayBuffer();

                const sourcePdf =
                  await PDFDocument.load(bytes);

                const pages =
                  await outputPdf.copyPages(
                    sourcePdf,
                    sourcePdf.getPageIndices()
                  );

                pages.forEach((page) =>
                  outputPdf.addPage(page)
                );
              }

              const bytes =
                await outputPdf.save();

              downloadBlob(
                new Blob([bytes], {
                  type: 'application/pdf',
                }),
                'toolatlas-merged.pdf'
              );

              result.innerHTML =
                '<div class="success"><strong>PDFs merged successfully.</strong></div>';

              return;
            }

            const file = files[0];

            const source =
              await PDFDocument.load(
                await file.arrayBuffer()
              );

            if (mode === 'split-pdf') {
              const pageText =
                document.querySelector('#pdf-pages')?.value ||
                '';

              const indexes = pageText
                .split(',')
                .map((value) => Number(value.trim()) - 1)
                .filter(
                  (value) =>
                    Number.isInteger(value) &&
                    value >= 0 &&
                    value < source.getPageCount()
                );

              if (!indexes.length) {
                throw new Error(
                  'Enter valid page numbers.'
                );
              }

              const outputPdf =
                await PDFDocument.create();

              const pages =
                await outputPdf.copyPages(
                  source,
                  indexes
                );

              pages.forEach((page) =>
                outputPdf.addPage(page)
              );

              const bytes =
                await outputPdf.save();

              downloadBlob(
                new Blob([bytes], {
                  type: 'application/pdf',
                }),
                'toolatlas-pages.pdf'
              );

              result.innerHTML =
                '<div class="success"><strong>Selected pages extracted.</strong></div>';

              return;
            }

            if (mode === 'rotate-pdf') {
              const rotation =
                Number(
                  document.querySelector(
                    '#pdf-rotation'
                  )?.value || 90
                );

              for (const page of source.getPages()) {
                page.setRotation(
                  degrees(rotation)
                );
              }

              const bytes =
                await source.save();

              downloadBlob(
                new Blob([bytes], {
                  type: 'application/pdf',
                }),
                'toolatlas-rotated.pdf'
              );

              result.innerHTML =
                '<div class="success"><strong>PDF rotated successfully.</strong></div>';

              return;
            }

            if (mode === 'compress-pdf') {
              const bytes =
                await source.save({
                  useObjectStreams: true,
                  addDefaultPage: false,
                });

              downloadBlob(
                new Blob([bytes], {
                  type: 'application/pdf',
                }),
                'toolatlas-optimized.pdf'
              );

              result.innerHTML =
                '<div class="success"><strong>Optimized PDF created.</strong><span>PDF optimization depends on the original document.</span></div>';
            }
          } catch (error) {
            result.innerHTML = `
              <p class="error">
                ${escapeHtml(
                  error?.message ||
                    'Unable to process this PDF.'
                )}
              </p>
            `;
          }
        });
    };

    const renderJpgPdf = async () => {
      app.innerHTML = `
        <div class="tool-form">
          <label class="file-label">
            <span>Choose JPG images</span>
            <input
              id="jpg-files"
              type="file"
              accept="image/jpeg,.jpg,.jpeg"
              multiple
            />
          </label>

          <div class="button-row">
            ${button('Create PDF', 'create-jpg-pdf')}
          </div>

          ${resultBox('jpg-pdf-result')}
        </div>
      `;

      document
        .querySelector('#create-jpg-pdf')
        ?.addEventListener('click', async () => {
          const files =
            document.querySelector('#jpg-files')?.files;

          const result =
            document.querySelector('#jpg-pdf-result');

          if (!files?.length) {
            result.innerHTML =
              '<p class="error">Choose at least one JPG image.</p>';
            return;
          }

          try {
            const module =
              await import(
                'https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/+esm'
              );

            const pdf =
              await module.PDFDocument.create();

            for (const file of files) {
              const bytes =
                new Uint8Array(
                  await file.arrayBuffer()
                );

              const image =
                await pdf.embedJpg(bytes);

              const page =
                pdf.addPage([
                  image.width,
                  image.height,
                ]);

              page.drawImage(image, {
                x: 0,
                y: 0,
                width: image.width,
                height: image.height,
              });
            }

            const bytes =
              await pdf.save();

            downloadBlob(
              new Blob([bytes], {
                type: 'application/pdf',
              }),
              'toolatlas-images.pdf'
            );

            result.innerHTML =
              '<div class="success"><strong>PDF created successfully.</strong></div>';
          } catch (error) {
            result.innerHTML = `
              <p class="error">
                ${escapeHtml(
                  error?.message ||
                    'Unable to create the PDF.'
                )}
              </p>
            `;
          }
        });
    };

    const renderTool = async () => {
      switch (slug) {
        case 'image-compressor':
        case 'image-resizer':
        case 'jpg-to-png':
        case 'png-to-jpg':
        case 'webp-to-jpg':
        case 'remove-exif':
          renderImageTool(slug);
          break;

        case 'jpg-to-pdf':
          await renderJpgPdf();
          break;

        case 'merge-pdf':
        case 'split-pdf':
        case 'rotate-pdf':
        case 'compress-pdf':
          await renderPdfTool(slug);
          break;

        case 'json-formatter':
        case 'json-validator':
        case 'base64-encoder-decoder':
        case 'url-encoder-decoder':
        case 'regex-tester':
        case 'word-counter':
        case 'case-converter':
        case 'text-cleaner':
          renderTextTool(slug);
          break;

        case 'uuid-generator':
          renderUuidTool();
          break;

        case 'timestamp-converter':
          renderTimestampTool();
          break;

        case 'password-generator':
          renderPasswordTool();
          break;

        case 'color-picker':
          renderColorTool();
          break;

        case 'cps-test':
          renderCpsTool();
          break;

        case 'reaction-time-test':
          renderReactionTool();
          break;

        case 'keyboard-test':
          renderKeyboardTool();
          break;

        case 'typing-test':
          renderTypingTool();
          break;

        case 'qr-code-generator':
          await renderQrTool(false);
          break;

        case 'wifi-qr-code':
          await renderQrTool(true);
          break;

        case 'barcode-generator':
          await renderBarcodeTool();
          break;

        default:
          app.innerHTML = `
            <div class="tool-form">
              <h3>${escapeHtml(tool.name)}</h3>
              <p>
                This ToolAtlas utility is being prepared for this browser
                environment.
              </p>
            </div>
          `;
      }
    };

    renderTool();
  }
</script>

