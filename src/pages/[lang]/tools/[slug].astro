      `;

      const buttonElement =
        document.querySelector(
          '#reaction-button'
        );

      const score =
        document.querySelector(
          '#reaction-score'
        );

      const status =
        document.querySelector(
          '#reaction-status'
        );

      let timeout;
      let start = 0;
      let waiting = false;
      let active = false;

      buttonElement.addEventListener(
        'click',
        () => {
          if (
            !waiting &&
            !active
          ) {
            waiting = true;

            buttonElement.textContent =
              'Wait…';

            status.textContent =
              'Do not click until the button changes.';

            timeout =
              setTimeout(
                () => {
                  waiting = false;
                  active = true;

                  start =
                    performance.now();

                  buttonElement.textContent =
                    'CLICK NOW';

                  buttonElement.className =
                    'reaction-button go';

                  status.textContent =
                    'Click as quickly as possible!';
                },
                1200 +
                  Math.random() *
                    3000
              );

            return;
          }

          if (waiting) {
            clearTimeout(
              timeout
            );

            waiting = false;

            buttonElement.textContent =
              'Too early — try again';

            status.textContent =
              'You clicked before the signal.';

            return;
          }

          if (active) {
            const reaction =
              performance.now() -
              start;

            active = false;

            score.textContent =
              `${Math.round(reaction)} ms`;

            buttonElement.textContent =
              'Try again';

            buttonElement.className =
              'reaction-button ready';

            status.textContent =
              'Test complete.';
          }
        }
      );
