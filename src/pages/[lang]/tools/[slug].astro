                '!@#$%^&*()-_=+[]{};:,.?';
            }

            if (!chars) {
              alert(
                'Select at least one character type.'
              );
              return;
            }

            const count =
              Number(
                length?.value || 20
              );

            const values =
              new Uint32Array(
                count
              );

            crypto.getRandomValues(
              values
            );

            let password = '';

            for (
              let i = 0;
              i < count;
              i++
            ) {
