          </div>

          <div id="typing-stats" class="stats-grid"></div>
        </div>
      `;

      const input =
        document.querySelector('#typing-input');

      const stats =
        document.querySelector('#typing-stats');

      let startTime = 0;
      let active = false;

      document
        .querySelector('#typing-start')
        ?.addEventListener('click', () => {
          active = true;
          startTime = performance.now();

          input.disabled = false;
          input.value = '';
          input.focus();

          stats.innerHTML = `
            <div><strong>0</strong><span>WPM</span></div>
            <div><strong>0%</strong><span>Accuracy</span></div>
          `;
        });

      input.addEventListener('input', () => {
        if (!active) return;

        const value = input.value;
        const elapsed =
          (performance.now() - startTime) / 60000;

        const correct = [...value].filter(
          (char, index) =>
            char === sample[index]
        ).length;

        const accuracy =
          value.length > 0
            ? (correct / value.length) * 100
            : 0;

        const words =
          value.trim().length / 5;

        const wpm =
          elapsed > 0 ? words / elapsed : 0;

        stats.innerHTML = `
          <div>
            <strong>${Math.round(wpm)}</strong>
            <span>WPM</span>
          </div>

          <div>
            <strong>${Math.round(accuracy)}%</strong>
            <span>Accuracy</span>
          </div>

          <div>
            <strong>${value.length}</strong>
            <span>Characters</span>
          </div>
        `;

        if (value === sample) {
          active = false;
          input.disabled = true;
        }
      });

      document
        .querySelector('#typing-reset')
        ?.addEventListener('click', () => {
          active = false;
          input.disabled = true;
          input.value = '';

          stats.innerHTML = '';
        });
    };

