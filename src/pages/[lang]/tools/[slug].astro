          );

          if (
            pressed.length >
            20
          ) {
            pressed.pop();
          }

          history.innerHTML =
            pressed
              .map(
                (key) =>
                  `<span class="key-chip">${escapeHtml(key)}</span>`
              )
              .join('');
        }
      );
    };

    const renderTypingTool = () => {
      const samples = [
        'Fast typing starts with accuracy. Keep your hands relaxed and focus on the text.',
        'Good typing speed comes from consistent practice and correct finger placement.',
        'Simple daily practice can improve typing accuracy, rhythm, and confidence.',
      ];

      const sample =
        samples[
          Math.floor(
            Math.random() *
              samples.length
          )
        ];

      app.innerHTML = `
        <div class="typing-test">

          <div class="typing-target">
            ${escapeHtml(sample)}
          </div>

          <textarea
            id="typing-input"
            class="tool-textarea"
            placeholder="Start typing the text above..."
            disabled
          ></textarea>

          <div class="button-row">
            ${button(
              'Start test →',
              'typing-start'
            )}

            ${button(
              'Reset',
              'typing-reset'
            )}
          </div>

          <div
            id="typing-stats"
            class="stats-grid"
          ></div>

        </div>
      `;

      const input =
        document.querySelector(
          '#typing-input'
        );

      const stats =
        document.querySelector(
          '#typing-stats'
        );

      let startTime = 0;
      let active = false;

      document
        .querySelector(
          '#typing-start'
        )
        ?.addEventListener(
          'click',
          () => {
            active = true;

            startTime =
              performance.now();

            input.disabled =
              false;

            input.value = '';

            input.focus();

            stats.innerHTML = `
              <div>
                <strong>0</strong>
                <span>WPM</span>
              </div>

              <div>
                <strong>0%</strong>
                <span>Accuracy</span>
              </div>
            `;
          }
        );

      input.addEventListener(
        'input',
        () => {
          if (!active) return;

          const value =
            input.value;

          const elapsed =
            (
              performance.now() -
              startTime
            ) / 60000;

          const correct =
            [
              ...value,
            ].filter(
              (char, index) =>
                char ===
                sample[index]
            ).length;

          const accuracy =
            value.length > 0
              ? (
                  correct /
                  value.length
                ) * 100
              : 0;

          const words =
            value.trim()
              .length / 5;

          const wpm =
            elapsed > 0
              ? words / elapsed
              : 0;

          stats.innerHTML = `
            <div>
              <strong>
                ${Math.round(wpm)}
              </strong>
              <span>WPM</span>
            </div>

            <div>
              <strong>
                ${Math.round(accuracy)}%
              </strong>
              <span>Accuracy</span>
            </div>

            <div>
              <strong>
                ${value.length}
              </strong>
              <span>Characters</span>
            </div>
          `;

          if (
            value === sample
          ) {
            active = false;
            input.disabled =
              true;
          }
        }
      );

      document
        .querySelector(
          '#typing-reset'
        )
        ?.addEventListener(
          'click',
          () => {
            active = false;

            input.disabled =
              true;

            input.value = '';

            stats.innerHTML =
              '';
          }
        );
    };

    const renderQrTool = async (
      wifi = false
    ) => {
      app.innerHTML = `
        <div class="tool-form">

          ${
            wifi
              ? `
                <label>
                  <span class="field-title">
                    Wi-Fi network name
                  </span>

                  ${input(
                    'wifi-ssid',
                    'text',
                    'Network name'
                  )}
                </label>

                <label>
                  <span class="field-title">
                    Password
                  </span>

                  ${input(
                    'wifi-password',
                    'text',
                    'Wi-Fi password'
                  )}
                </label>

                <label>
                  <span class="field-title">
                    Security
                  </span>

                  <select
                    id="wifi-security"
                    class="tool-input"
                  >
                    <option value="WPA">
                      WPA/WPA2
                    </option>

                    <option value="WEP">
                      WEP
                    </option>

                    <option value="nopass">
                      No password
                    </option>
                  </select>
                </label>
              `
              : `
                <label>
                  <span class="field-title">
                    Text or URL
                  </span>

                  ${input(
                    'qr-text',
                    'text',
                    'https://example.com'
                  )}
                </label>
              `
          }

          <div class="button-row">
            ${button(
              'Generate QR code →',
              'generate-qr'
            )}
          </div>

          <div
            id="qr-output"
            class="qr-output"
          ></div>

        </div>
      `;

      document
        .querySelector(
          '#generate-qr'
        )
        ?.addEventListener(
          'click',
          async () => {
            const output =
              document.querySelector(
                '#qr-output'
              );

            try {
              const module =
                await import(
                  'https://cdn.jsdelivr.net/npm/qrcode@1.5.4/+esm'
                );

              let value = '';

              if (wifi) {
                const ssid =
                  document.querySelector(
                    '#wifi-ssid'
                  )?.value || '';

                const password =
                  document.querySelector(
                    '#wifi-password'
                  )?.value || '';

                const security =
                  document.querySelector(
                    '#wifi-security'
                  )?.value ||
                  'WPA';

                value =
                  security ===
                  'nopass'
                    ? `WIFI:T:nopass;S:${ssid};;`
                    : `WIFI:T:${security};S:${ssid};P:${password};;`;
              } else {
                value =
                  document.querySelector(
                    '#qr-text'
                  )?.value || '';
              }

              if (!value) {
                output.innerHTML =
                  '<p class="error">Enter some content first.</p>';
                return;
              }

              const canvas =
                document.createElement(
                  'canvas'
                );

              await module.toCanvas(
                canvas,
                value,
                {
                  width: 300,
                  margin: 2,
                }
              );

              output.innerHTML =
                '';

              output.appendChild(
                canvas
              );

              const download =
                document.createElement(
                  'button'
                );

              download.className =
                'action-button';

              download.textContent =
                'Download QR code';

              download.onclick =
                () => {
                  canvas.toBlob(
                    (blob) => {
                      if (blob) {
                        downloadBlob(
                          blob,
                          'toolatlas-qr-code.png'
                        );
                      }
                    },
                    'image/png'
                  );
                };

              output.appendChild(
                download
              );
            } catch {
              output.innerHTML = `
                <p class="error">
                  QR generation could not be loaded.
                  Please check your connection and try again.
                </p>
              `;
            }
          }
        );
    };

    const renderBarcodeTool =
      async () => {
        app.innerHTML = `
          <div class="tool-form">

            <label>
              <span class="field-title">
                Barcode value
              </span>

              ${input(
                'barcode-value',
                'text',
                '123456789012'
              )}
            </label>

            <label>
              <span class="field-title">
                Format
              </span>

              <select
                id="barcode-format"
                class="tool-input"
              >
                <option value="CODE128">
                  CODE128
                </option>

                <option value="EAN13">
                  EAN-13
                </option>

                <option value="UPC">
                  UPC
                </option>
              </select>
            </label>

            <div class="button-row">
              ${button(
                'Generate barcode →',
                'generate-barcode'
              )}
            </div>

            <div
              id="barcode-output"
              class="barcode-output"
            ></div>

          </div>
        `;

        document
          .querySelector(
            '#generate-barcode'
          )
          ?.addEventListener(
            'click',
            async () => {
              const output =
                document.querySelector(
                  '#barcode-output'
                );

              try {
                const module =
                  await import(
                    'https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/+esm'
                  );

                const value =
                  document.querySelector(
                    '#barcode-value'
                  )?.value || '';

                const format =
                  document.querySelector(
                    '#barcode-format'
                  )?.value ||
                  'CODE128';

                if (!value) {
                  output.innerHTML =
                    '<p class="error">Enter a barcode value.</p>';
                  return;
                }

                const svg =
                  document.createElementNS(
                    'http://www.w3.org/2000/svg',
                    'svg'
                  );

                output.innerHTML =
                  '';

                output.appendChild(
                  svg
                );

                module.default(
                  svg,
                  value,
                  {
                    format,
                    displayValue:
                      true,
                    margin: 10,
                  }
                );

                const download =
                  document.createElement(
                    'button'
                  );

                download.className =
                  'action-button';

                download.textContent =
                  'Download SVG';

                download.onclick =
                  () => {
                    const serializer =
                      new XMLSerializer();

                    const source =
                      serializer.serializeToString(
                        svg
                      );

                    const blob =
                      new Blob(
                        [source],
                        {
                          type:
                            'image/svg+xml',
                        }
                      );

                    downloadBlob(
                      blob,
                      'toolatlas-barcode.svg'
                    );
                  };

                output.appendChild(
                  download
                );
              } catch {
                output.innerHTML = `
                  <p class="error">
                    Barcode generation could not be loaded.
                  </p>
                `;
              }
            }
          );
      };

    const renderPdfTool =
      async (mode) => {
        app.innerHTML = `
          <div class="tool-form">

            <label class="upload-zone">
              <span class="upload-symbol">↑</span>
              <strong>
                Select PDF${mode === 'merge-pdf' ? ' files' : ''}
              </strong>
              <small>
                Files are processed in your browser
              </small>

              <input
                id="pdf-files"
                type="file"
                accept="application/pdf,.pdf"
                ${mode === 'merge-pdf' ? 'multiple' : ''}
              />
            </label>

            ${
              mode === 'split-pdf'
                ? `
                  <label>
                    <span class="field-title">
                      Pages to extract
                    </span>

                    ${input(
                      'pdf-pages',
                      'text',
                      'Example: 1,3,5'
                    )}
                  </label>
                `
                : ''
            }

            ${
              mode === 'rotate-pdf'
                ? `
                  <label>
                    <span class="field-title">
                      Rotation
                    </span>

                    <select
                      id="pdf-rotation"
                      class="tool-input"
                    >
                      <option value="90">
                        90°
                      </option>

                      <option value="180">
                        180°
                      </option>

                      <option value="270">
                        270°
                      </option>
                    </select>
                  </label>
                `
                : ''
            }

            <div class="button-row">
              ${button(
                'Process PDF →',
                'process-pdf'
              )}
            </div>

            ${resultBox(
              'pdf-result'
            )}

          </div>
        `;

        document
          .querySelector(
            '#process-pdf'
          )
          ?.addEventListener(
            'click',
            async () => {
              const files =
                document.querySelector(
                  '#pdf-files'
                )?.files;

              const result =
                document.querySelector(
                  '#pdf-result'
                );

              if (!files?.length) {
                result.innerHTML =
                  '<p class="error">Choose a PDF file first.</p>';
                return;
              }

              try {
                const module =
                  await import(
                    'https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/+esm'
                  );

                const {
                  PDFDocument,
                  degrees,
                } = module;

                if (
                  mode ===
                  'merge-pdf'
                ) {
                  const outputPdf =
                    await PDFDocument.create();

                  for (
                    const file of files
                  ) {
                    const bytes =
                      await file.arrayBuffer();

                    const sourcePdf =
                      await PDFDocument.load(
                        bytes
                      );

                    const pages =
                      await outputPdf.copyPages(
                        sourcePdf,
                        sourcePdf.getPageIndices()
                      );

                    pages.forEach(
                      (page) =>
                        outputPdf.addPage(
                          page
                        )
                    );
                  }

                  const bytes =
                    await outputPdf.save();

                  downloadBlob(
                    new Blob(
                      [bytes],
                      {
                        type:
                          'application/pdf',
                      }
                    ),
                    'toolatlas-merged.pdf'
                  );

                  result.innerHTML =
                    '<div class="success"><strong>✓ PDFs merged successfully.</strong></div>';

                  return;
                }

                const file =
                  files[0];

                const source =
                  await PDFDocument.load(
                    await file.arrayBuffer()
                  );

                if (
                  mode ===
                  'split-pdf'
                ) {
                  const pageText =
                    document.querySelector(
                      '#pdf-pages'
                    )?.value ||
                    '';

                  const indexes =
                    pageText
                      .split(',')
                      .map(
                        (value) =>
                          Number(
                            value.trim()
                          ) - 1
                      )
                      .filter(
                        (value) =>
                          Number.isInteger(
                            value
                          ) &&
                          value >=
                            0 &&
                          value <
                            source.getPageCount()
                      );

                  if (
                    !indexes.length
                  ) {
                    throw new Error(
                      'Enter valid page numbers.'
                    );
                  }

                  const outputPdf =
                    await PDFDocument.create();

                  const pages =
                    await outputPdf.copyPages(
                      source,
                      indexes
                    );

                  pages.forEach(
                    (page) =>
                      outputPdf.addPage(
                        page
                      )
                  );

                  const bytes =
                    await outputPdf.save();

                  downloadBlob(
                    new Blob(
                      [bytes],
                      {
                        type:
                          'application/pdf',
                      }
                    ),
                    'toolatlas-pages.pdf'
                  );

                  result.innerHTML =
                    '<div class="success"><strong>✓ Selected pages extracted.</strong></div>';

                  return;
                }

                if (
                  mode ===
                  'rotate-pdf'
                ) {
                  const rotation =
                    Number(
                      document.querySelector(
                        '#pdf-rotation'
                      )?.value ||
                        90
                    );

                  for (
                    const page of source.getPages()
                  ) {
                    page.setRotation(
                      degrees(
                        rotation
                      )
                    );
                  }

                  const bytes =
                    await source.save();

                  downloadBlob(
                    new Blob(
                      [bytes],
                      {
                        type:
                          'application/pdf',
                      }
                    ),
                    'toolatlas-rotated.pdf'
                  );

                  result.innerHTML =
                    '<div class="success"><strong>✓ PDF rotated successfully.</strong></div>';

                  return;
                }

                if (
                  mode ===
                  'compress-pdf'
                ) {
                  const bytes =
                    await source.save(
                      {
                        useObjectStreams:
                          true,
                        addDefaultPage:
                          false,
                      }
                    );

                  downloadBlob(
                    new Blob(
                      [bytes],
                      {
                        type:
                          'application/pdf',
                      }
                    ),
                    'toolatlas-optimized.pdf'
                  );

                  result.innerHTML =
                    '<div class="success"><strong>✓ Optimized PDF created.</strong><span>Optimization depends on the original document.</span></div>';
                }
              } catch (error) {
                result.innerHTML = `
                  <p class="error">
                    ${escapeHtml(
                      error?.message ||
                        'Unable to process this PDF.'
                    )}
                  </p>
                `;
              }
            }
          );
      };

    const renderJpgPdf =
      async () => {
        app.innerHTML = `
          <div class="tool-form">

            <label class="upload-zone">
              <span class="upload-symbol">↑</span>
              <strong>
                Choose JPG images
              </strong>
              <small>
                Select one or more images
              </small>

              <input
                id="jpg-files"
                type="file"
                accept="image/jpeg,.jpg,.jpeg"
                multiple
              />
            </label>

            <div class="button-row">
              ${button(
                'Create PDF →',
                'create-jpg-pdf'
              )}
            </div>

            ${resultBox(
              'jpg-pdf-result'
            )}

          </div>
        `;

        document
          .querySelector(
            '#create-jpg-pdf'
          )
          ?.addEventListener(
            'click',
            async () => {
              const files =
                document.querySelector(
                  '#jpg-files'
                )?.files;

              const result =
                document.querySelector(
                  '#jpg-pdf-result'
                );

              if (!files?.length) {
                result.innerHTML =
                  '<p class="error">Choose at least one JPG image.</p>';
                return;
              }

              try {
                const module =
                  await import(
                    'https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/+esm'
                  );

                const pdf =
                  await module.PDFDocument.create();

                for (
                  const file of files
                ) {
                  const bytes =
                    new Uint8Array(
                      await file.arrayBuffer()
                    );

                  const image =
                    await pdf.embedJpg(
                      bytes
                    );

                  const page =
                    pdf.addPage(
                      [
                        image.width,
                        image.height,
                      ]
                    );

                  page.drawImage(
                    image,
                    {
                      x: 0,
                      y: 0,
                      width:
                        image.width,
                      height:
                        image.height,
                    }
                  );
                }

                const bytes =
                  await pdf.save();

                downloadBlob(
                  new Blob(
                    [bytes],
                    {
                      type:
                        'application/pdf',
                    }
                  ),
                  'toolatlas-images.pdf'
                );

                result.innerHTML =
                  '<div class="success"><strong>✓ PDF created successfully.</strong></div>';
              } catch (error) {
                result.innerHTML = `
                  <p class="error">
                    ${escapeHtml(
                      error?.message ||
                        'Unable to create the PDF.'
                    )}
                  </p>
                `;
              }
            }
          );
      };

    const renderTool =
      async () => {
        switch (slug) {
          case 'image-compressor':
          case 'image-resizer':
          case 'jpg-to-png':
          case 'png-to-jpg':
          case 'webp-to-jpg':
          case 'remove-exif':
            renderImageTool(slug);
            break;

          case 'jpg-to-pdf':
            await renderJpgPdf();
            break;

          case 'merge-pdf':
          case 'split-pdf':
          case 'rotate-pdf':
          case 'compress-pdf':
            await renderPdfTool(slug);
            break;

          case 'json-formatter':
          case 'json-validator':
          case 'base64-encoder-decoder':
          case 'url-encoder-decoder':
          case 'regex-tester':
          case 'word-counter':
          case 'case-converter':
          case 'text-cleaner':
            renderTextTool(slug);
            break;

          case 'uuid-generator':
            renderUuidTool();
            break;

          case 'timestamp-converter':
            renderTimestampTool();
            break;

          case 'password-generator':
            renderPasswordTool();
            break;

          case 'color-picker':
            renderColorTool();
            break;

          case 'cps-test':
            renderCpsTool();
            break;

          case 'reaction-time-test':
            renderReactionTool();
            break;

          case 'keyboard-test':
            renderKeyboardTool();
            break;

          case 'typing-test':
            renderTypingTool();
            break;

          case 'qr-code-generator':
            await renderQrTool(false);
            break;

          case 'wifi-qr-code':
            await renderQrTool(true);
            break;

          case 'barcode-generator':
            await renderBarcodeTool();
            break;

          default:
            app.innerHTML = `
              <div class="tool-form">
                <div class="keyboard-info">
                  <span class="info-icon">✦</span>

                  <div>
                    <strong>
                      ${escapeHtml(
                        tool.name
                      )}
                    </strong>

                    <p>
                      This ToolAtlas utility is being prepared
                      for this browser environment.
                    </p>
                  </div>
                </div>
              </div>
            `;
        }
      };

    renderTool();
  }
</script>

