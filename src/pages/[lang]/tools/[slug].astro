        </div>
      `;

      const score = document.querySelector('#cps-score');
      const buttonElement =
        document.querySelector('#cps-button');
      const status = document.querySelector('#cps-status');

      let clicks = 0;
      let start = 0;
      let running = false;
      let timer;

      buttonElement.addEventListener('click', () => {
        if (!running) {
          clicks = 1;
          start = performance.now();
          running = true;

          const duration =
            Number(
              document.querySelector('#cps-duration').value
            ) * 1000;

          buttonElement.textContent = 'Click!';
          status.textContent = 'Test running…';

          timer = setTimeout(() => {
            running = false;

            const seconds =
              (performance.now() - start) / 1000;

            const cps = clicks / seconds;

            score.textContent = cps.toFixed(2);
            buttonElement.textContent = 'Start again';
            status.textContent =
              `Finished — ${clicks} clicks in ${seconds.toFixed(2)} seconds.`;
          }, duration);

          score.textContent = '1';
        } else {
          clicks++;
          score.textContent = (
            clicks /
            ((performance.now() - start) / 1000)
          ).toFixed(2);
        }
      });
    };

    const renderReactionTool = () => {
      app.innerHTML = `
        <div class="test-panel">
          <div class="test-number" id="reaction-score">—</div>
          <p>Reaction time in milliseconds</p>

          <button id="reaction-button" class="reaction-button ready" type="button">
            Click to start
          </button>

          <p id="reaction-status" class="muted">
            Wait for the button to change.
          </p>
        </div>
      `;

      const buttonElement =
        document.querySelector('#reaction-button');

      const score =
        document.querySelector('#reaction-score');

      const status =
        document.querySelector('#reaction-status');

      let timeout;
      let start = 0;
      let waiting = false;
      let active = false;

      buttonElement.addEventListener('click', () => {
        if (!waiting && !active) {
          waiting = true;
          buttonElement.textContent = 'Wait…';
          status.textContent =
            'Do not click until the button changes.';

          timeout = setTimeout(() => {
            waiting = false;
            active = true;
            start = performance.now();

            buttonElement.textContent = 'CLICK NOW';
            buttonElement.className =
              'reaction-button go';

            status.textContent =
              'Click as quickly as possible!';
          }, 1200 + Math.random() * 3000);

          return;
        }

        if (waiting) {
          clearTimeout(timeout);
          waiting = false;

          buttonElement.textContent =
            'Too early — try again';

          status.textContent =
            'You clicked before the signal.';
          return;
        }

        if (active) {
          const reaction =
            performance.now() - start;

          active = false;

          score.textContent =
            `${Math.round(reaction)} ms`;

          buttonElement.textContent =
            'Try again';

          buttonElement.className =
            'reaction-button ready';

          status.textContent =
            'Test complete.';
        }
      });
    };

