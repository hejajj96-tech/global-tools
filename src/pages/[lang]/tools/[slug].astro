---
import Layout from '../../../layouts/Layout.astro';
import { langCodes } from '../../../data/i18n';
import { tools } from '../../../data/tools';

export function getStaticPaths() {
  const paths = [];

  for (const lang of langCodes) {
    for (const tool of tools) {
      paths.push({
        params: {
          lang,
          slug: tool.slug,
        },
        props: {
          lang,
          tool,
        },
      });
    }
  }

  return paths;
}

const { lang, tool } = Astro.props;

const siteUrl = 'https://global-tools.pages.dev';
const canonical = `${siteUrl}/${lang}/tools/${tool.slug}/`;

const title = `${tool.name} — Free Online Tool | ToolAtlas`;
const description =
  tool.description ||
  `${tool.name} is a free online tool from ToolAtlas. Fast, simple, private, and easy to use.`;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonical={canonical}
>
  <main class="tool-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>Home</a>
      <span>/</span>
      <a href={`/${lang}/tools/`}>Tools</a>
      <span>/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">ToolAtlas</p>
      <h1>{tool.name}</h1>

      <p class="description">
        {tool.description ||
          `Use ${tool.name} online for free. No registration required.`}
      </p>
    </header>

    <section class="tool-card" aria-label={tool.name}>
      <div class="tool-placeholder">
        <h2>{tool.name}</h2>

        <p>
          This tool is available in ToolAtlas. The interactive tool interface
          will be loaded here.
        </p>

        <button type="button">
          Launch Tool
        </button>
      </div>
    </section>

    <section class="content">
      <h2>About {tool.name}</h2>

      <p>
        ToolAtlas provides free online tools designed to be fast, simple, and
        easy to use. No account is required for basic browser-based tools.
      </p>

      <h2>How to use this tool</h2>

      <ol>
        <li>Open the tool on your device.</li>
        <li>Enter or upload the required information.</li>
        <li>Run the tool and review the result.</li>
      </ol>
    </section>
  </main>
</Layout>

<style>
  .tool-page {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 40px 0 80px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 50px;
    color: #667085;
    font-size: 14px;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .hero {
    max-width: 800px;
    margin-bottom: 40px;
  }

  .eyebrow {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #667085;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 7vw, 64px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .description {
    margin-top: 22px;
    max-width: 720px;
    color: #667085;
    font-size: 18px;
    line-height: 1.7;
  }

  .tool-card {
    margin-top: 35px;
    padding: 32px;
    border: 1px solid #e4e7ec;
    border-radius: 24px;
    background: #fff;
  }

  .tool-placeholder {
    min-height: 260px;
    display: grid;
    place-items: center;
    text-align: center;
    align-content: center;
    gap: 12px;
  }

  .tool-placeholder h2 {
    margin: 0;
  }

  .tool-placeholder p {
    max-width: 600px;
    color: #667085;
    line-height: 1.7;
  }

  button {
    border: 0;
    border-radius: 12px;
    padding: 12px 20px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .content {
    max-width: 800px;
    margin: 55px auto 0;
    line-height: 1.8;
  }

  .content h2 {
    margin-top: 42px;
    margin-bottom: 12px;
  }

  .content p,
  .content li {
    color: #667085;
  }

  @media (max-width: 640px) {
    .tool-page {
      width: min(100% - 28px, 1100px);
      padding-top: 25px;
    }

    .breadcrumb {
      margin-bottom: 35px;
    }

    .tool-card {
      padding: 22px;
      border-radius: 18px;
    }
  }
</style>
