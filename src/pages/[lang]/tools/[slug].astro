    const renderColorTool = () => {
      app.innerHTML = `
        <div class="tool-form">
          <label>
            <span>Choose a color</span>
            <input id="color" class="color-picker" type="color" value="#2563eb" />
          </label>

          ${resultBox('color-result')}
        </div>
      `;

      const color = document.querySelector('#color');
      const result = document.querySelector('#color-result');

      const update = () => {
        const hex = color.value;

        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);

        const max = Math.max(r, g, b) / 255;
        const min = Math.min(r, g, b) / 255;

        let h = 0;
        let s = 0;
        const l = (max + min) / 2;

        if (max !== min) {
          const d = max - min;

          s =
            l > 0.5
              ? d / (2 - max - min)
              : d / (max + min);

          switch (max) {
            case r / 255:
              h =
                ((g - b) / 255 / d +
                  (g < b ? 6 : 0)) /
                6;
              break;

            case g / 255:
              h =
                ((b - r) / 255 / d + 2) /
                6;
              break;

            case b / 255:
              h =
                ((r - g) / 255 / d + 4) /
                6;
              break;
          }
        }

        result.innerHTML = `
          <div class="color-preview" style="background:${hex}"></div>

          <div class="stats-grid">
            <div>
              <strong>${hex.toUpperCase()}</strong>
              <span>HEX</span>
            </div>

            <div>
              <strong>rgb(${r}, ${g}, ${b})</strong>
              <span>RGB</span>
            </div>

            <div>
              <strong>${Math.round(h * 360)}° ${Math.round(s * 100)}% ${Math.round(l * 100)}%</strong>
              <span>HSL</span>
            </div>
          </div>
        `;
      };

      color.addEventListener('input', update);
      update();
    };

