          () => {
            let chars = '';

            if (
              document.querySelector(
                '#pw-upper'
              )?.checked
            ) {
              chars +=
                'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            }

            if (
              document.querySelector(
                '#pw-lower'
              )?.checked
            ) {
              chars +=
                'abcdefghijklmnopqrstuvwxyz';
            }

            if (
              document.querySelector(
                '#pw-numbers'
              )?.checked
            ) {
              chars +=
                '0123456789';
            }

            if (
              document.querySelector(
                '#pw-symbols'
              )?.checked
            ) {
