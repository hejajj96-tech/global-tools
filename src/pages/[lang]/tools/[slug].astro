---
import Layout from '../../../layouts/Layout.astro';
import { langCodes } from '../../../data/i18n';
import { tools } from '../../../data/tools';

export function getStaticPaths() {
  const paths = [];

  for (const lang of langCodes) {
    for (const tool of tools) {
      paths.push({
        params: {
          lang,
          slug: tool.slug,
        },
        props: {
          lang,
          tool,
        },
      });
    }
  }

  return paths;
}

const { lang, tool } = Astro.props;

const siteUrl = 'https://global-tools.hejajj96.workers.dev';
const canonical = `${siteUrl}/${lang}/tools/${tool.slug}/`;

const title = `${tool.name} — Free Online Tool | ToolAtlas`;

const description =
  tool.description ||
  `${tool.name} is a free online tool from ToolAtlas. Fast, simple, private, and easy to use.`;

const slug = tool.slug;

const toolMeta: Record<
  string,
  {
    intro: string;
    steps: string[];
    accept?: string;
    inputMode?: string;
  }
> = {
  'image-compressor': {
    intro:
      'Compress JPG, PNG, and WebP images directly in your browser. Reduce file size while keeping useful image quality.',
    steps: [
      'Choose an image from your device.',
      'Select the output quality.',
      'Compress the image and download the result.',
    ],
    accept: 'image/*',
  },

  'image-resizer': {
    intro:
      'Resize images online in your browser. Set the width and height and download the resized image.',
    steps: [
      'Choose an image.',
      'Enter the desired dimensions.',
      'Resize and download the image.',
    ],
    accept: 'image/*',
  },

  'jpg-to-png': {
    intro:
      'Convert JPG images to PNG format directly in your browser without uploading the image to a server.',
    steps: [
      'Choose a JPG image.',
      'Convert it to PNG.',
      'Download the PNG file.',
    ],
    accept: 'image/jpeg,.jpg,.jpeg',
  },

  'png-to-jpg': {
    intro:
      'Convert PNG images to JPG format directly in your browser.',
    steps: [
      'Choose a PNG image.',
      'Select a background color if transparency is present.',
      'Download the JPG result.',
    ],
    accept: 'image/png,.png',
  },

  'webp-to-jpg': {
    intro:
      'Convert WebP images to JPG directly in your browser.',
    steps: [
      'Choose a WebP image.',
      'Convert it to JPG.',
      'Download the converted image.',
    ],
    accept: 'image/webp,.webp',
  },

  'remove-exif': {
    intro:
      'Create a clean copy of an image without embedded metadata by re-encoding it in your browser.',
    steps: [
      'Choose an image.',
      'Select the output format.',
      'Download the metadata-cleaned image.',
    ],
    accept: 'image/*',
  },

  'jpg-to-pdf': {
    intro:
      'Convert a JPG image into a printable PDF document directly in your browser.',
    steps: [
      'Choose a JPG image.',
      'Create the PDF.',
      'Download the generated document.',
    ],
    accept: 'image/jpeg,.jpg,.jpeg',
  },

  'merge-pdf': {
    intro:
      'Combine PDF files into one document directly in your browser.',
    steps: [
      'Select two or more PDF files.',
      'Arrange them in the selected order.',
      'Create and download the merged PDF.',
    ],
    accept: 'application/pdf,.pdf',
  },

  'split-pdf': {
    intro:
      'Extract selected pages from a PDF document directly in your browser.',
    steps: [
      'Choose a PDF file.',
      'Enter the page numbers to extract.',
      'Create and download the new PDF.',
    ],
    accept: 'application/pdf,.pdf',
  },

  'rotate-pdf': {
    intro:
      'Rotate PDF pages directly in your browser and create a new PDF file.',
    steps: [
      'Choose a PDF file.',
      'Choose the rotation angle.',
      'Create and download the rotated PDF.',
    ],
    accept: 'application/pdf,.pdf',
  },

  'compress-pdf': {
    intro:
      'Create a smaller PDF where browser-side optimization is supported.',
    steps: [
      'Choose a PDF file.',
      'Run the browser-side optimization.',
      'Download the resulting PDF.',
    ],
    accept: 'application/pdf,.pdf',
  },

  'json-formatter': {
    intro:
      'Format JSON into readable, structured JSON directly in your browser.',
    steps: [
      'Paste your JSON.',
      'Click Format JSON.',
      'Copy the formatted result.',
    ],
  },

  'json-validator': {
    intro:
      'Validate JSON syntax instantly in your browser.',
    steps: [
      'Paste your JSON.',
      'Click Validate JSON.',
      'Review the validation result.',
    ],
  },

  'base64-encoder-decoder': {
    intro:
      'Encode text to Base64 or decode Base64 back to text directly in your browser.',
    steps: [
      'Enter text or Base64 data.',
      'Choose encode or decode.',
      'Copy the result.',
    ],
  },

  'url-encoder-decoder': {
    intro:
      'Encode or decode URL text using standard browser URL encoding.',
    steps: [
      'Enter a URL or text.',
      'Choose encode or decode.',
      'Copy the result.',
    ],
  },

  'uuid-generator': {
    intro:
      'Generate random UUID values instantly in your browser.',
    steps: [
      'Choose how many UUIDs you need.',
      'Generate them.',
      'Copy the generated values.',
    ],
  },

  'regex-tester': {
    intro:
      'Test regular expressions against text directly in your browser.',
    steps: [
      'Enter a regular expression.',
      'Enter test text.',
      'Review the matches.',
    ],
  },

  'timestamp-converter': {
    intro:
      'Convert Unix timestamps to dates and dates to Unix timestamps.',
    steps: [
      'Enter a timestamp or date.',
      'Choose the conversion.',
      'Copy the result.',
    ],
  },

  'word-counter': {
    intro:
      'Count words, characters, sentences, and lines in your text.',
    steps: [
      'Paste or type your text.',
      'Review the live statistics.',
      'Copy or edit the text as needed.',
    ],
  },

  'case-converter': {
    intro:
      'Convert text between uppercase, lowercase, title case, and sentence case.',
    steps: [
      'Enter your text.',
      'Choose the desired case.',
      'Copy the converted result.',
    ],
  },

  'text-cleaner': {
    intro:
      'Clean extra spaces, blank lines, and common formatting issues from text.',
    steps: [
      'Paste your text.',
      'Choose the cleaning operation.',
      'Copy the cleaned result.',
    ],
  },

  'typing-test': {
    intro:
      'Measure typing speed and accuracy with a browser-based typing test.',
    steps: [
      'Start the test.',
      'Type the displayed text.',
      'Review your speed and accuracy.',
    ],
  },

  'cps-test': {
    intro:
      'Measure clicks per second with a simple browser-based CPS test.',
    steps: [
      'Choose the test duration.',
      'Start the test.',
      'Click as quickly as possible.',
    ],
  },

  'keyboard-test': {
    intro:
      'Test your keyboard keys directly in your browser.',
    steps: [
      'Click inside the keyboard test.',
      'Press the keys you want to test.',
      'Check which keys are detected.',
    ],
  },

  'qr-code-generator': {
    intro:
      'Generate a QR code from text or a URL directly in your browser.',
    steps: [
      'Enter text or a URL.',
      'Generate the QR code.',
      'Download the generated image.',
    ],
  },

  'wifi-qr-code': {
    intro:
      'Generate a QR code containing Wi-Fi connection information.',
    steps: [
      'Enter the Wi-Fi network name.',
      'Enter the password and security type.',
      'Generate and download the QR code.',
    ],
  },

  'barcode-generator': {
    intro:
      'Generate common barcode formats directly in your browser.',
    steps: [
      'Enter the barcode value.',
      'Choose the barcode format.',
      'Generate and download the barcode.',
    ],
  },

  'password-generator': {
    intro:
      'Generate strong random passwords locally in your browser.',
    steps: [
      'Choose the password length.',
      'Select the character types.',
      'Generate and copy the password.',
    ],
  },

  'color-picker': {
    intro:
      'Pick a color and copy its HEX, RGB, and HSL values.',
    steps: [
      'Choose a color.',
      'Review the color values.',
      'Copy the value you need.',
    ],
  },

  'reaction-time-test': {
    intro:
      'Measure your reaction time with a simple browser-based reaction test.',
    steps: [
      'Start the test.',
      'Wait until the screen changes.',
      'Click as quickly as possible and review your result.',
    ],
  },
};

const meta = toolMeta[slug] || {
  intro: description,
  steps: [
    'Open the tool.',
    'Enter or upload the required information.',
    'Run the tool and review the result.',
  ],
};
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonical={canonical}
  webApplication={true}
>
  <div
    class="tool-page"
    data-tool={slug}
    data-lang={lang}
  >
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>Home</a>
      <span>/</span>
      <a href={`/${lang}/tools/`}>Tools</a>
      <span>/</span>
      <span aria-current="page">{tool.name}</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">ToolAtlas · Free Online Tool</p>

      <h1>{tool.name}</h1>

      <p class="description">
        {meta.intro}
      </p>

      <div class="trust-row">
        <span>✓ Free to use</span>
        <span>✓ No registration</span>
        <span>✓ Browser-based</span>
      </div>
    </header>

    <section
      class="tool-card"
      aria-labelledby="tool-interface-title"
    >
      <div class="tool-heading">
        <div>
          <span class="tool-label">ONLINE TOOL</span>
          <h2 id="tool-interface-title">{tool.name}</h2>
        </div>

        <span class="privacy-badge">
          Client-side
        </span>
      </div>

      <div
        id="tool-app"
        class="tool-app"
      >
        <noscript>
          <p>
            JavaScript is required to use this online tool.
          </p>
        </noscript>

        <div class="loading-state">
          Loading tool…
        </div>
      </div>
    </section>

    <section class="content">
      <h2>About {tool.name}</h2>

      <p>
        {meta.intro}
        ToolAtlas is designed to provide fast browser-based utilities
        without requiring an account for basic tools. Whenever technically
        possible, processing happens directly on your device.
      </p>

      <h2>How to use {tool.name}</h2>

      <ol>
        {meta.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      <h2>{tool.name} online</h2>

      <p>
        Use {tool.name} directly from your browser on desktop, tablet, or
        mobile. The interface is designed to keep the workflow simple and
        avoid unnecessary registration steps.
      </p>
    </section>
  </div>
</Layout>

<script>
  const root = document.querySelector('.tool-page');
  const app = document.querySelector('#tool-app');

  if (root && app) {
    const slug = root.getAttribute('data-tool') || '';

    const escapeHtml = (value) =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const button = (label, id = '') =>
      `<button class="action-button" type="button" ${id ? `id="${id}"` : ''}>${label}</button>`;

    const textarea = (id, placeholder = '') =>
      `<textarea id="${id}" class="tool-textarea" placeholder="${placeholder}"></textarea>`;

    const input = (id, type = 'text', placeholder = '') =>
      `<input id="${id}" class="tool-input" type="${type}" placeholder="${placeholder}" />`;

    const resultBox = (id) =>
      `<div id="${id}" class="result-box" aria-live="polite"></div>`;

    const downloadBlob = (blob, filename) => {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    const copyText = async (value) => {
      await navigator.clipboard.writeText(value);
    };

    const imageToCanvas = (file, maxWidth = null, maxHeight = null) =>
      new Promise((resolve, reject) => {
        const image = new Image();

        image.onload = () => {
          let width = image.naturalWidth;
          let height = image.naturalHeight;

          if (maxWidth && width > maxWidth) {
            const ratio = maxWidth / width;
            width = Math.round(width * ratio);
            height = Math.round(height * ratio);
          }

          if (maxHeight && height > maxHeight) {
            const ratio = maxHeight / height;
            width = Math.round(width * ratio);
            height = Math.round(height * ratio);
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;

          const ctx = canvas.getContext('2d');

          if (!ctx) {
            reject(new Error('Canvas is not supported.'));
            return;
          }

          ctx.drawImage(image, 0, 0, width, height);
          resolve(canvas);

          URL.revokeObjectURL(image.src);
        };

        image.onerror = () =>
          reject(new Error('Unable to read this image.'));

        image.src = URL.createObjectURL(file);
      });

    const canvasBlob = (canvas, type, quality = undefined) =>
      new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (!blob) {
              reject(new Error('Unable to create the output file.'));
              return;
            }

            resolve(blob);
          },
          type,
          quality
        );
      });

    const renderImageTool = (mode) => {
      app.innerHTML = `
        <div class="tool-form">
          <label class="file-label">
            <span>Choose an image</span>
            <input id="image-file" type="file" accept="image/*" />
          </label>

          ${
            mode === 'image-compressor'
              ? `
                <label>
                  <span>Quality: <strong id="quality-value">80%</strong></span>
                  <input id="quality" type="range" min="10" max="100" value="80" />
                </label>
              `
              : ''
          }

          ${
            mode === 'image-resizer'
              ? `
                <div class="field-grid">
                  <label>
                    <span>Width</span>
                    <input id="resize-width" class="tool-input" type="number" min="1" placeholder="Width" />
                  </label>
                  <label>
                    <span>Height</span>
                    <input id="resize-height" class="tool-input" type="number" min="1" placeholder="Height" />
                  </label>
                </div>
              `
              : ''
          }

          ${
            mode === 'png-to-jpg'
              ? `
                <label>
                  <span>Background color</span>
                  <input id="bg-color" type="color" value="#ffffff" />
                </label>
              `
              : ''
          }

          <div class="button-row">
            ${button(
              mode === 'image-compressor'
                ? 'Compress image'
                : mode === 'image-resizer'
                  ? 'Resize image'
                  : mode === 'remove-exif'
                    ? 'Clean metadata'
                    : 'Convert image',
              'process-image'
            )}
          </div>

          ${resultBox('image-result')}
        </div>
      `;

      const quality = document.querySelector('#quality');
      const qualityValue = document.querySelector('#quality-value');

      if (quality && qualityValue) {
        quality.addEventListener('input', () => {
          qualityValue.textContent = `${quality.value}%`;
        });
      }

      document
        .querySelector('#process-image')
        ?.addEventListener('click', async () => {
          const fileInput = document.querySelector('#image-file');
          const result = document.querySelector('#image-result');

          if (!fileInput?.files?.[0]) {
            result.innerHTML =
              '<p class="error">Please choose an image first.</p>';
            return;
          }

          const file = fileInput.files[0];

          try {
            let canvas;

            if (mode === 'image-resizer') {
              const width = Number(
                document.querySelector('#resize-width')?.value
              );
              const height = Number(
                document.querySelector('#resize-height')?.value
              );

              if (!width || !height) {
                throw new Error('Enter both width and height.');
              }

              canvas = await imageToCanvas(file);

              const resized = document.createElement('canvas');
              resized.width = width;
              resized.height = height;

              const ctx = resized.getContext('2d');

              if (!ctx) {
                throw new Error('Canvas is not supported.');
              }

              ctx.drawImage(canvas, 0, 0, width, height);
              canvas = resized;
            } else {
              canvas = await imageToCanvas(file);
            }

            if (mode === 'png-to-jpg') {
              const ctx = canvas.getContext('2d');

              if (!ctx) {
                throw new Error('Canvas is not supported.');
              }

              ctx.globalCompositeOperation = 'destination-over';
              ctx.fillStyle =
                document.querySelector('#bg-color')?.value || '#ffffff';

              ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            const type =
              mode === 'jpg-to-png'
                ? 'image/png'
                : mode === 'webp-to-jpg' ||
                    mode === 'png-to-jpg' ||
                    mode === 'remove-exif'
                  ? 'image/jpeg'
                  : file.type || 'image/jpeg';

            const qualityValueNumber =
              Number(
                document.querySelector('#quality')?.value || 80
              ) / 100;

            const blob = await canvasBlob(
              canvas,
              type,
              mode === 'image-compressor'
                ? qualityValueNumber
                : 0.92
            );

            const extension =
              type === 'image/png' ? 'png' : 'jpg';

            const outputName =
              file.name.replace(/\.[^/.]+$/, '') +
              `-toolatlas.${extension}`;

            downloadBlob(blob, outputName);

            result.innerHTML = `
              <div class="success">
                <strong>Done.</strong>
                <span>${escapeHtml(outputName)}</span>
                <span>${Math.round(blob.size / 1024)} KB</span>
              </div>
            `;
          } catch (error) {
            result.innerHTML = `
              <p class="error">
                ${escapeHtml(error?.message || 'Something went wrong.')}
              </p>
            `;
          }
        });
    };

    const renderTextTool = (mode) => {
      const initial = mode === 'json-formatter' || mode === 'json-validator'
        ? '{\n  "hello": "world"\n}'
        : '';

      app.innerHTML = `
        <div class="tool-form">
          <label>
            <span>Input</span>
            <textarea id="main-input" class="tool-textarea" placeholder="Enter or paste your text here...">${escapeHtml(initial)}</textarea>
          </label>

          ${
            mode === 'case-converter'
              ? `
                <div class="button-row">
                  ${button('UPPERCASE', 'upper')}
                  ${button('lowercase', 'lower')}
                  ${button('Title Case', 'title-case')}
                  ${button('Sentence case', 'sentence-case')}
                </div>
              `
              : ''
          }

          ${
            mode === 'base64-encoder-decoder'
              ? `
                <div class="button-row">
                  ${button('Encode Base64', 'encode')}
                  ${button('Decode Base64', 'decode')}
                </div>
              `
              : ''
          }

          ${
            mode === 'url-encoder-decoder'
              ? `
                <div class="button-row">
                  ${button('Encode URL', 'encode')}
                  ${button('Decode URL', 'decode')}
                </div>
              `
              : ''
          }

          ${
            mode === 'text-cleaner'
              ? `
                <div class="button-row">
                  ${button('Clean text', 'clean')}
                </div>
              `
              : ''
          }

          ${
            mode === 'json-formatter'
              ? `
                <div class="button-row">
                  ${button('Format JSON', 'format')}
                  ${button('Minify JSON', 'minify')}
                </div>
              `
              : ''
          }

          ${
            mode === 'json-validator'
              ? `
                <div class="button-row">
                  ${button('Validate JSON', 'validate')}
                </div>
              `
              : ''
          }

          ${
            mode === 'word-counter'
              ? `
                <div id="live-stats" class="stats-grid"></div>
              `
              : ''
          }

          ${
            mode === 'regex-tester'
              ? `
                <label>
                  <span>Regular expression</span>
                  <input id="regex-input" class="tool-input" placeholder="\\bhello\\b" />
                </label>

                <label class="checkbox-row">
                  <input id="regex-global" type="checkbox" checked />
                  Global
                </label>

                <div class="button-row">
                  ${button('Test expression', 'test-regex')}
                </div>
              `
              : ''
          }

          ${
            mode !== 'word-counter' &&
            mode !== 'case-converter' &&
            mode !== 'base64-encoder-decoder' &&
            mode !== 'url-encoder-decoder' &&
            mode !== 'text-cleaner' &&
            mode !== 'json-formatter' &&
            mode !== 'json-validator' &&
            mode !== 'regex-tester'
              ? `
                <div class="button-row">
                  ${button('Process', 'process-text')}
                </div>
              `
              : ''
          }

          ${
            mode === 'case-converter' ||
            mode === 'base64-encoder-decoder' ||
            mode === 'url-encoder-decoder' ||
            mode === 'text-cleaner' ||
            mode === 'json-formatter'
              ? `
                <label>
                  <span>Result</span>
                  <textarea id="main-output" class="tool-textarea" readonly></textarea>
                </label>

                <div class="button-row">
                  ${button('Copy result', 'copy-result')}
                </div>
              `
              : ''
          }

          ${
            mode === 'json-validator' || mode === 'regex-tester'
              ? resultBox('text-result')
              : ''
          }
        </div>
      `;

      const mainInput = document.querySelector('#main-input');

      if (mode === 'word-counter' && mainInput) {
        const stats = document.querySelector('#live-stats');

        const update = () => {
          const value = mainInput.value;
          const words = value.trim()
            ? value.trim().split(/\s+/).length
            : 0;

          const chars = value.length;
          const charsNoSpaces = value.replace(/\s/g, '').length;
          const lines = value ? value.split(/\r?\n/).length : 0;
          const sentences = value
            .split(/[.!?]+/)
            .filter((item) => item.trim()).length;

          stats.innerHTML = `
            <div><strong>${words}</strong><span>Words</span></div>
            <div><strong>${chars}</strong><span>Characters</span></div>
            <div><strong>${charsNoSpaces}</strong><span>No spaces</span></div>
            <div><strong>${lines}</strong><span>Lines</span></div>
            <div><strong>${sentences}</strong><span>Sentences</span></div>
          `;
        };

        mainInput.addEventListener('input', update);
        update();
      }

      const output = document.querySelector('#main-output');

      const setOutput = (value) => {
        if (output) {
          output.value = value;
        }
      };

      document.querySelector('#upper')?.addEventListener('click', () => {
        setOutput(mainInput?.value.toUpperCase() || '');
      });

      document.querySelector('#lower')?.addEventListener('click', () => {
        setOutput(mainInput?.value.toLowerCase() || '');
      });

      document
        .querySelector('#title-case')
        ?.addEventListener('click', () => {
          setOutput(
            (mainInput?.value || '')
              .toLowerCase()
              .replace(/\b\w/g, (letter) => letter.toUpperCase())
          );
        });

      document
        .querySelector('#sentence-case')
        ?.addEventListener('click', () => {
          const value = (mainInput?.value || '').toLowerCase();

          setOutput(
            value.replace(
              /(^\s*\w|[.!?]\s+\w)/g,
              (match) => match.toUpperCase()
            )
          );
        });

      document
        .querySelector('#encode')
        ?.addEventListener('click', () => {
          if (mode === 'base64-encoder-decoder') {
            try {
              setOutput(
                btoa(
                  unescape(
                    encodeURIComponent(mainInput?.value || '')
                  )
                )
              );
            } catch {
              setOutput('Unable to encode this text.');
            }
          } else {
            setOutput(
              encodeURIComponent(mainInput?.value || '')
            );
          }
        });

      document
        .querySelector('#decode')
        ?.addEventListener('click', () => {
          if (mode === 'base64-encoder-decoder') {
            try {
              setOutput(
                decodeURIComponent(
                  escape(
                    atob(mainInput?.value || '')
                  )
                )
              );
            } catch {
              setOutput('Invalid Base64 input.');
            }
          } else {
            try {
              setOutput(
                decodeURIComponent(mainInput?.value || '')
              );
            } catch {
              setOutput('Invalid encoded URL.');
            }
          }
        });

      document
        .querySelector('#clean')
        ?.addEventListener('click', () => {
          setOutput(
            (mainInput?.value || '')
              .replace(/[ \t]+/g, ' ')
