---
import Layout from '../../../layouts/Layout.astro'; import {tools} from '../../../data/tools'; import {languages,langCodes} from '../../../data/i18n';
export function getStaticPaths(){return langCodes.map(lang=>({params:{lang},props:{lang}}))} const {lang}=Astro.props; const i=languages[lang];
---
<Layout title={`${i.all} — ToolAtlas`} description={`${i.all}. Free online tools for images, PDF, developers, text, tests and QR codes.`} lang={lang} canonical={`https://YOUR-DOMAIN.com/${lang}/tools/`}><main class="container"><div class="head"><div><div class="eyebrow">ToolAtlas</div><h1>{i.all}</h1><p class="muted">Fast browser-first utilities with no signup.</p></div></div><div class="grid">{tools.map(t=><a class="card" href={`/${lang}/tools/${t.slug}/`}><span class="icon">{t.icon}</span><div><h2>{t.name}</h2><p>{t.description}</p><small>{t.category}</small></div><span>→</span></a>)}</div></main></Layout>
<style>.container{max-width:1180px;margin:auto;padding:55px 22px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#667085}.head h1{font-size:50px;letter-spacing:-.06em;margin:8px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:35px}.card{display:grid;grid-template-columns:46px 1fr 15px;gap:13px;padding:18px;background:#fff;border:1px solid #e4e7ec;border-radius:16px}.card h2{font-size:17px;margin:1px 0 6px}.card p{font-size:13px;color:#667085;line-height:1.5;margin:0 0 8px}.card small{color:#98a2b3}.icon{width:46px;height:46px;border-radius:12px;background:#101828;color:#fff;display:grid;place-items:center;font-weight:800}@media(max-width:800px){.grid{grid-template-columns:1fr}}
</style>
