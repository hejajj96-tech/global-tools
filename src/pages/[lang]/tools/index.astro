---
import Layout from '../../../layouts/Layout.astro';
import { SITE_URL } from '../../../data/site';
import { langCodes, getLocale } from '../../../data/i18n';
import { tools } from '../../../data/tools';
import { categoriesData } from '../../../data/categories';
import { getToolLocalizedInfo } from '../../../data/toolTranslations';

export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const loc = getLocale(lang);
const canonical = `${SITE_URL}/${lang}/tools/`;

const breadcrumbs = [
  { name: loc.breadcrumbHome, url: `/${lang}/` },
  { name: loc.breadcrumbTools, url: `/${lang}/tools/` },
];
---

<Layout
  title={`${loc.allTools} — ToolAtlas`}
  description={`${loc.allTools}: ${loc.exploreTools} (${tools.length} ${loc.functionalToolsCount}). ${loc.categoryTaglineSuffix}`}
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{loc.breadcrumbHome}</a>
      <span>›</span>
      <strong>{loc.breadcrumbTools}</strong>
    </nav>

    <header class="hero">
      <div class="badge">{loc.tools.toUpperCase()}</div>
      <h1>{loc.allTools}</h1>
      <p>
        {loc.homeLead}
      </p>
    </header>

    <!-- Category Filter Chips -->
    <div class="category-chips">
      <a href={`/${lang}/tools/`} class="chip active">{loc.allTools} ({tools.length})</a>
      {
        categoriesData.map((cat) => {
          const localizedName = loc.categoryLabels[cat.slug] || cat.name;
          const count = tools.filter((t) => t.categorySlug === cat.slug).length;
          return (
            <a href={`/${lang}/categories/${cat.slug}/`} class="chip">
              {cat.icon} {localizedName} ({count})
            </a>
          );
        })
      }
    </div>

    <!-- Grouped Tools by Category -->
    {
      categoriesData.map((cat) => {
        const catTools = tools.filter((t) => t.categorySlug === cat.slug);
        const localizedName = loc.categoryLabels[cat.slug] || cat.name;
        const localizedDesc = loc.categoryDescriptions[cat.slug] || cat.description;

        return (
          <section class="category-block" id={cat.slug}>
            <div class="cat-block-header">
              <div class="cat-title-wrap">
                <span class="cat-icon">{cat.icon}</span>
                <div>
                  <h2>{localizedName}</h2>
                  <p>{localizedDesc}</p>
                </div>
              </div>
              <a href={`/${lang}/categories/${cat.slug}/`} class="cat-more-link">
                {loc.viewAll} →
              </a>
            </div>

            <div class="tools-grid">
              {catTools.map((tool) => {
                const toolLoc = getToolLocalizedInfo(tool.slug, lang);
                return (
                  <a href={`/${lang}/tools/${tool.slug}/`} class="tool-card">
                    <span class="tool-icon">{tool.icon}</span>
                    <div class="tool-info">
                      <strong>{toolLoc.name}</strong>
                      <small>{toolLoc.description}</small>
                    </div>
                    <span class="arrow">→</span>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })
    }

    <!-- AdSense Placement -->
    <div class="ad-slot" aria-label={loc.advertisement}>
      <span class="ad-label">{loc.advertisement}</span>
      <div class="ad-placeholder">
        <small>Ad space reserved for Google AdSense compliance</small>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 90px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #22d3ee;
  }

  .hero {
    max-width: 820px;
    margin-bottom: 35px;
  }

  .badge {
    display: inline-flex;
    padding: 5px 12px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 16px 0 0;
    font-size: clamp(38px, 6vw, 64px);
    letter-spacing: -0.05em;
    color: #ffffff;
  }

  .hero p {
    margin: 16px 0 0;
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
  }

  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 50px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .chip {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: #cbd5e1;
    text-decoration: none;
    font-size: 13px;
    font-weight: 650;
    transition: all 0.2s ease;
  }

  .chip:hover,
  .chip.active {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(34, 211, 238, 0.12);
    color: #ffffff;
  }

  .category-block {
    margin-bottom: 55px;
  }

  .cat-block-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    gap: 20px;
  }

  .cat-title-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cat-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(99, 102, 241, 0.2));
    border: 1px solid rgba(34, 211, 238, 0.25);
    font-size: 20px;
  }

  .cat-title-wrap h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .cat-title-wrap p {
    margin: 4px 0 0;
    color: #8d93aa;
    font-size: 13px;
  }

  .cat-more-link {
    color: #22d3ee;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .tool-card {
    display: grid;
    grid-template-columns: 44px 1fr 16px;
    gap: 14px;
    align-items: center;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .tool-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .tool-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #111426;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #22d3ee;
    font-weight: 800;
  }

  .tool-info strong {
    display: block;
    font-size: 15px;
    color: #ffffff;
  }

  .tool-info small {
    display: block;
    margin-top: 4px;
    color: #8d93aa;
    font-size: 12px;
    line-height: 1.4;
  }

  .arrow {
    color: #6366f1;
    font-weight: 800;
  }

  .ad-slot {
    margin: 60px 0 20px;
    padding: 18px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    text-align: center;
    background: rgba(255, 255, 255, 0.015);
  }

  .ad-label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
    margin-bottom: 8px;
  }

  .ad-placeholder {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
  }

  @media (max-width: 960px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page {
      padding: 24px 0 60px;
    }
    .cat-block-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
