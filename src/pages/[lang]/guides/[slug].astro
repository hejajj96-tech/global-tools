---
import Layout from '../../../layouts/Layout.astro';
import { SITE_URL } from '../../../data/site';
import { langCodes, getLocale } from '../../../data/i18n';
import { guidesData, type Guide } from '../../../data/guides';
import { getToolBySlug } from '../../../data/tools';

export function getStaticPaths() {
  const paths = [];

  for (const lang of langCodes) {
    for (const guide of guidesData) {
      paths.push({
        params: {
          lang,
          slug: guide.slug,
        },
        props: {
          lang,
          guide,
        },
      });
    }
  }

  return paths;
}

interface Props {
  lang: string;
  guide: Guide;
}

const { lang, guide } = Astro.props;
const loc = getLocale(lang);
const canonical = `${SITE_URL}/${lang}/guides/${guide.slug}/`;

const tool = getToolBySlug(guide.relatedToolSlug);
const otherGuides = guidesData.filter((g) => g.slug !== guide.slug).slice(0, 3);

const breadcrumbs = [
  { name: loc.breadcrumbHome, url: `/${lang}/` },
  { name: loc.breadcrumbGuides, url: `/${lang}/guides/` },
  { name: guide.title, url: `/${lang}/guides/${guide.slug}/` },
];

const articleMeta = {
  title: guide.title,
  description: guide.description,
  publishDate: guide.publishDate,
};
---

<Layout
  title={`${guide.title} — ToolAtlas Guide`}
  description={guide.description}
  lang={lang}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  faqItems={guide.faqs}
  article={articleMeta}
>
  <article class="article-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{loc.breadcrumbHome}</a>
      <span>›</span>
      <a href={`/${lang}/guides/`}>{loc.breadcrumbGuides}</a>
      <span>›</span>
      <strong>{guide.title}</strong>
    </nav>

    <header class="article-header">
      <div class="header-meta">
        <a href={`/${lang}/categories/${guide.categorySlug}/`} class="category-pill">
          {guide.category}
        </a>
        <span class="reading-time">⏱ {guide.readingTime}</span>
        <span class="publish-date">Published {guide.publishDate}</span>
      </div>

      <h1>{guide.title}</h1>
      <p class="intro-lead">{guide.intro}</p>
    </header>

    <!-- Interactive Tool Callout -->
    {
      tool && (
        <aside class="tool-cta-box" aria-label="Interactive Tool">
          <div class="tool-cta-left">
            <span class="cta-icon">{tool.icon}</span>
            <div>
              <span class="cta-label">TRY IT ONLINE</span>
              <h3>{tool.name}</h3>
              <p>{tool.description}</p>
            </div>
          </div>
          <a href={`/${lang}/tools/${tool.slug}/`} class="launch-btn">
            Open {tool.name} →
          </a>
        </aside>
      )
    }

    <!-- Article Content -->
    <div class="article-body">
      {
        guide.sections.map((section) => (
          <section class="guide-section">
            <h2>{section.heading}</h2>

            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}

            {section.callout && (
              <div class="callout-box">
                <span class="callout-icon">💡</span>
                <p>{section.callout}</p>
              </div>
            )}

            {section.codeSnippet && (
              <pre class="code-box">
                <code>{section.codeSnippet}</code>
              </pre>
            )}
          </section>
        ))
      }

      <!-- Key Takeaways Box -->
      <section class="takeaways-box">
        <h3>📌 Key Takeaways</h3>
        <ul>
          {guide.keyTakeaways.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>

      <!-- AdSense Slot -->
      <div class="ad-slot" aria-label={loc.advertisement}>
        <span class="ad-label">{loc.advertisement}</span>
        <div class="ad-placeholder">
          <small>Ad space reserved for Google AdSense compliance</small>
        </div>
      </div>

      <!-- FAQ Accordion -->
      {
        guide.faqs && guide.faqs.length > 0 && (
          <section class="faq-section" aria-labelledby="faq-title">
            <h2 id="faq-title">{loc.faqs}</h2>

            <div class="faq-list">
              {guide.faqs.map((faq) => (
                <details class="faq-item">
                  <summary>
                    <strong>{faq.question}</strong>
                    <span class="faq-toggle">+</span>
                  </summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <!-- Related Guides Navigation -->
      <section class="related-section">
        <h2>{loc.relatedGuides}</h2>
        <div class="related-grid">
          {otherGuides.map((item) => (
            <a href={`/${lang}/guides/${item.slug}/`} class="related-card">
              <span class="related-cat">{item.category}</span>
              <h4>{item.title}</h4>
              <p>{item.description}</p>
              <span class="related-link">{loc.readGuide}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    width: min(860px, calc(100% - 32px));
    margin: 0 auto;
    padding: 34px 0 90px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #22d3ee;
  }

  .article-header {
    margin-bottom: 35px;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    font-size: 12px;
  }

  .category-pill {
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.25);
    color: #22d3ee;
    text-decoration: none;
    font-weight: 700;
  }

  .reading-time,
  .publish-date {
    color: #8d93aa;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5.5vw, 54px);
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .intro-lead {
    margin: 20px 0 0;
    color: #aab4c5;
    font-size: 18px;
    line-height: 1.7;
  }

  .tool-cta-box {
    margin: 35px 0 45px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid rgba(34, 211, 238, 0.3);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.08), rgba(99, 102, 241, 0.08));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .tool-cta-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #111426;
    border: 1px solid rgba(34, 211, 238, 0.3);
    color: #22d3ee;
    font-size: 22px;
    flex-shrink: 0;
  }

  .cta-label {
    font-size: 10px;
    font-weight: 800;
    color: #22d3ee;
    letter-spacing: 0.12em;
  }

  .tool-cta-left h3 {
    margin: 2px 0 0;
    font-size: 18px;
    color: #ffffff;
  }

  .tool-cta-left p {
    margin: 4px 0 0;
    color: #94a3b8;
    font-size: 13px;
  }

  .launch-btn {
    padding: 12px 22px;
    border-radius: 12px;
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: #ffffff;
    font-weight: 750;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(34, 211, 238, 0.2);
  }

  .launch-btn:hover {
    transform: translateY(-2px);
  }

  .article-body {
    line-height: 1.8;
  }

  .guide-section {
    margin-bottom: 45px;
  }

  .guide-section h2 {
    margin: 0 0 16px;
    font-size: 26px;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .guide-section p {
    margin: 0 0 18px;
    color: #c4c8d9;
    font-size: 16px;
  }

  .callout-box {
    margin: 22px 0;
    padding: 18px 22px;
    border-radius: 14px;
    border-left: 4px solid #22d3ee;
    background: rgba(34, 211, 238, 0.06);
    display: flex;
    gap: 12px;
  }

  .callout-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .callout-box p {
    margin: 0;
    color: #e2e8f0;
    font-size: 14px;
    line-height: 1.6;
  }

  .code-box {
    margin: 20px 0;
    padding: 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0b0d18;
    overflow-x: auto;
    font-size: 13px;
    color: #38bdf8;
  }

  .takeaways-box {
    margin: 45px 0;
    padding: 26px;
    border-radius: 18px;
    border: 1px solid rgba(52, 211, 153, 0.25);
    background: rgba(52, 211, 153, 0.04);
  }

  .takeaways-box h3 {
    margin: 0 0 14px;
    font-size: 19px;
    color: #6ee7b7;
  }

  .takeaways-box ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
  }

  .takeaways-box li {
    color: #cbd5e1;
    font-size: 15px;
  }

  .faq-section {
    margin: 50px 0;
  }

  .faq-section h2 {
    margin: 0 0 20px;
    font-size: 26px;
    color: #ffffff;
  }

  .faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
    padding: 16px 20px;
  }

  .faq-item[open] {
    border-color: rgba(34, 211, 238, 0.3);
    background: rgba(255, 255, 255, 0.04);
  }

  .faq-item summary {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #ffffff;
    font-size: 15px;
    user-select: none;
  }

  .faq-toggle {
    color: #22d3ee;
    font-size: 18px;
    font-weight: 800;
  }

  .faq-item p {
    margin: 12px 0 0;
    color: #aab4c5;
    font-size: 14px;
    line-height: 1.7;
  }

  .related-section {
    margin-top: 60px;
    padding-top: 35px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .related-section h2 {
    margin: 0 0 20px;
    font-size: 24px;
    color: #ffffff;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .related-card {
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .related-card:hover {
    border-color: rgba(34, 211, 238, 0.4);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .related-cat {
    font-size: 11px;
    color: #22d3ee;
    font-weight: 700;
  }

  .related-card h4 {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }

  .related-card p {
    margin: 0;
    color: #8d93aa;
    font-size: 12px;
    line-height: 1.5;
    flex: 1;
  }

  .related-link {
    color: #22d3ee;
    font-size: 12px;
    font-weight: 700;
  }

  .ad-slot {
    margin: 50px 0;
    padding: 18px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    text-align: center;
    background: rgba(255, 255, 255, 0.015);
  }

  .ad-label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
    margin-bottom: 8px;
  }

  .ad-placeholder {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
  }

  @media (max-width: 760px) {
    .tool-cta-box {
      flex-direction: column;
      align-items: flex-start;
    }
    .launch-btn {
      width: 100%;
      text-align: center;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .article-page {
      padding: 24px 0 60px;
    }
  }
</style>
