---
import '../styles/global.css';

const siteUrl = 'https://global-tools.hejajj96.workers.dev';

const {
  title,
  description,
  lang = 'en',
  canonical = `${siteUrl}/${lang}/`,
  noindex = false,
  alternates = []
} = Astro.props;

const langs = ['en', 'es', 'fr', 'de', 'it', 'pt', 'ar', 'tr', 'hi', 'ja'];

const cleanCanonical = canonical
  .replace('https://global-tools.pages.dev', siteUrl)
  .replace('https://global-tools.pages.dev/', siteUrl + '/')
  .replace('https://YOUR-DOMAIN.com', siteUrl);

const generatedAlternates = langs.map((language) => ({
  lang: language,
  href: cleanCanonical.replace(`/${lang}/`, `/${language}/`)
}));

const finalAlternates = alternates.length > 0
  ? alternates.map((a: any) => ({
      lang: a.lang,
      href: a.href
        .replace('https://global-tools.pages.dev', siteUrl)
        .replace('https://YOUR-DOMAIN.com', siteUrl)
    }))
  : generatedAlternates;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={cleanCanonical} />

    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta name="theme-color" content="#101828" />

    <link rel="icon" href="data:," />

    {finalAlternates.map((a: any) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}

    <link
      rel="alternate"
      hreflang="x-default"
      href={cleanCanonical.replace(`/${lang}/`, '/en/')}
    />
  </head>

  <body>
    <header
      style="background:#fff;border-bottom:1px solid #eaecf0;position:sticky;top:0;z-index:20"
    >
      <div
        class="container"
        style="height:70px;display:flex;align-items:center;gap:26px"
      >
        <a
          href={`/${lang}/`}
          style="font-size:21px;font-weight:900;letter-spacing:-.04em"
        >
          Tool<span style="color:#667085">Atlas</span>
        </a>

        <nav
          style="display:flex;gap:20px;font-size:14px;font-weight:650;flex:1"
        >
          <a href={`/${lang}/tools/`}>Tools</a>
          <a href={`/${lang}/categories/`}>Categories</a>
          <a href={`/${lang}/about/`}>About</a>
        </nav>

        <select
          aria-label="Language"
          onchange="location.href='/' + this.value + '/'"
        >
          <option value={lang}>{lang.toUpperCase()}</option>

          {langs
            .filter((x) => x !== lang)
            .map((x) => <option value={x}>{x.toUpperCase()}</option>)}
        </select>

        <a class="btn primary" href={`/${lang}/tools/`}>
          Explore tools
        </a>
      </div>
    </header>

    <slot />

    <footer
      style="margin-top:70px;border-top:1px solid #eaecf0;background:#fff"
    >
      <div
        class="container"
        style="padding:38px 22px;display:flex;gap:25px;justify-content:space-between;flex-wrap:wrap"
      >
        <div>
          <strong>ToolAtlas</strong>

          <p class="muted" style="max-width:440px">
            Fast, privacy-first online tools for everyday work. Built to
            process data locally whenever technically possible.
          </p>
        </div>

        <div style="display:flex;gap:18px;font-size:14px">
          <a href={`/${lang}/privacy/`}>Privacy</a>
          <a href={`/${lang}/terms/`}>Terms</a>
          <a href={`/${lang}/contact/`}>Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
