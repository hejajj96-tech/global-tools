---
import '../styles/global.css';

const siteUrl = 'https://global-tools.hejajj96.workers.dev';

const {
  title = 'ToolAtlas',
  description = 'Free online tools for everyday work.',
  lang = 'en',
  canonical = `${siteUrl}/${lang}/`,
  noindex = false,
  webApplication = false
} = Astro.props;

const languages = [
  'en',
  'es',
  'fr',
  'de',
  'it',
  'pt',
  'ar',
  'tr',
  'hi',
  'ja'
];

const cleanUrl = (url: string) => {
  return url
    .replace('https://global-tools.pages.dev', siteUrl)
    .replace('https://YOUR-DOMAIN.com', siteUrl)
    .replace(/([^:]\/)\/+/g, '$1');
};

const cleanCanonical = cleanUrl(canonical);

const currentPath = new URL(cleanCanonical).pathname;

const translatedAlternates = languages.map((language) => {
  const path = currentPath.replace(
    new RegExp(`^/${lang}(?=/|$)`),
    `/${language}`
  );

  return {
    lang: language,
    href: cleanUrl(`${siteUrl}${path}`)
  };
});

const xDefault =
  translatedAlternates.find((item) => item.lang === 'en')?.href ||
  `${siteUrl}/en/`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolAtlas',
  url: siteUrl,
  description,
  inLanguage: lang
};

const applicationSchema = webApplication
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      url: cleanCanonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires a modern web browser',
      isAccessibleForFree: true,
      inLanguage: lang
    }
  : null;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="google-site-verification"
      content="QYadnpR-zqV0v5eyf2IsFG-DbYOMsXPgLvbsjwi-FuE"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content={
        noindex
          ? 'noindex,follow'
          : 'index,follow,max-image-preview:large'
      }
    />

    <link
      rel="canonical"
      href={cleanCanonical}
    />

    <meta
      name="theme-color"
      content="#080b12"
    />

    <meta
      name="application-name"
      content="ToolAtlas"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={cleanCanonical}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="ToolAtlas"
    />

    <meta
      property="og:locale"
      content={lang}
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <link
      rel="icon"
      href="data:,"
    />

    {translatedAlternates.map((item) => (
      <link
        rel="alternate"
        hreflang={item.lang}
        href={item.href}
      />
    ))}

    <link
      rel="alternate"
      hreflang="x-default"
      href={xDefault}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    {applicationSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(applicationSchema)}
      />
    )}
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="brand"
          href={`/${lang}/`}
          aria-label="ToolAtlas home"
        >
          <span class="brand-icon">T</span>
          <span>
            Tool<span class="brand-muted">Atlas</span>
          </span>
        </a>

        <nav
          class="main-nav"
          aria-label="Main navigation"
        >
          <a href={`/${lang}/tools/`}>
            Tools
          </a>

          <a href={`/${lang}/categories/`}>
            Categories
          </a>

          <a href={`/${lang}/about/`}>
            About
          </a>
        </nav>

        <div class="header-actions">
          <label
            class="sr-only"
            for="language-selector"
          >
            Language
          </label>

          <select
            id="language-selector"
            aria-label="Language"
            onchange="
              const target = this.value;
              const path = window.location.pathname;
              const translated = path.replace(/^\/[^/]+/, '/' + target);
              window.location.href = translated;
            "
          >
            {languages.map((language) => (
              <option
                value={language}
                selected={language === lang}
              >
                {language.toUpperCase()}
              </option>
            ))}
          </select>

          <a
            class="header-button"
            href={`/${lang}/tools/`}
          >
            Explore tools
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-info">
          <div class="footer-brand">
            <span class="brand-icon small">T</span>
            <strong>ToolAtlas</strong>
          </div>

          <p>
            Fast, privacy-first online tools for everyday work.
            Built to process data locally whenever technically possible.
          </p>
        </div>

        <nav
          class="footer-links"
          aria-label="Footer navigation"
        >
          <a href={`/${lang}/tools/`}>
            Tools
          </a>

          <a href={`/${lang}/privacy/`}>
            Privacy
          </a>

          <a href={`/${lang}/terms/`}>
            Terms
          </a>

          <a href={`/${lang}/contact/`}>
            Contact
          </a>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} ToolAtlas
        </span>

        <span>
          Free online tools
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    background: #080b12;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 10% 0%,
        rgba(0, 229, 255, 0.08),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 10%,
        rgba(124, 58, 237, 0.1),
        transparent 30%
      ),
      #080b12;
    color: #f8fafc;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 11, 18, 0.9);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(1180px, calc(100% - 32px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    text-decoration: none;
    font-size: 21px;
    font-weight: 900;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .brand-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(
      135deg,
      #00e5ff,
      #7c3aed
    );
    color: #ffffff;
    font-weight: 900;
    box-shadow:
      0 0 22px rgba(0, 229, 255, 0.25),
      0 0 28px rgba(124, 58, 237, 0.18);
  }

  .brand-icon.small {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-size: 13px;
  }

  .brand-muted {
    color: #94a3b8;
  }

  .main-nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .main-nav a,
  .footer-links a {
    color: #aab4c5;
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
    transition: color 0.2s ease;
  }

  .main-nav a:hover,
  .footer-links a:hover {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #language-selector {
    min-height: 38px;
    padding: 0 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    outline: none;
  }

  .header-button {
    min-height: 38px;
    padding: 0 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(
      135deg,
      #00c6ff,
      #7c3aed
    );
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    box-shadow:
      0 8px 26px rgba(0, 198, 255, 0.14);
  }

  .site-footer {
    margin-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(3, 6, 12, 0.8);
  }

  .footer-inner {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 30px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-info {
    max-width: 470px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
  }

  .footer-info p {
    margin: 14px 0 0;
    color: #8792a5;
    line-height: 1.7;
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .footer-bottom {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #667085;
    font-size: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: auto;
      padding: 13px 0;
      flex-wrap: wrap;
      gap: 14px;
    }

    .main-nav {
      order: 3;
      width: 100%;
      justify-content: center;
      gap: 18px;
      padding-bottom: 3px;
    }

    .header-actions {
      margin-left: auto;
    }

    .header-button {
      display: none;
    }

    .footer-inner {
      flex-direction: column;
      padding-top: 34px;
    }

    .footer-links {
      gap: 16px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 7px;
    }
  }

  @media (max-width: 430px) {
    .header-inner,
    .footer-inner,
    .footer-bottom {
      width: calc(100% - 22px);
    }

    .brand {
      font-size: 19px;
    }

    .brand-icon {
      width: 31px;
      height: 31px;
    }

    .main-nav {
      gap: 15px;
    }

    .main-nav a {
      font-size: 13px;
    }
  }
</style>
