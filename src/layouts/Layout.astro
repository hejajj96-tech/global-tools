---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, LANGUAGES } from '../data/site';
import { getLocale } from '../data/i18n';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface ArticleMeta {
  title: string;
  description: string;
  publishDate: string;
  author?: string;
}

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  noindex?: boolean;
  webApplication?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: FaqItem[];
  article?: ArticleMeta;
}

const {
  title = `${SITE_NAME} — Free Online Tools`,
  description = 'Free, fast, browser-based online tools for images, PDFs, developers, text, QR codes, and everyday digital productivity.',
  lang = 'en',
  canonical = `${SITE_URL}/${lang}/`,
  noindex = false,
  webApplication = false,
  breadcrumbs = [],
  faqItems = [],
  article,
} = Astro.props;

const locale = getLocale(lang);

// Clean up canonical
const cleanCanonical = canonical
  .replace('https://global-tools.pages.dev', SITE_URL)
  .replace('https://YOUR-DOMAIN.com', SITE_URL)
  .replace(/([^:]\/)\/+/g, '$1');

let currentPath = '';
try {
  currentPath = new URL(cleanCanonical).pathname;
} catch {
  currentPath = `/${lang}/`;
}

// Generate exact reciprocal hreflang links
const isRoot = currentPath === '/' || currentPath === '';

const translatedAlternates = LANGUAGES.map((language) => {
  let path = '';
  if (isRoot) {
    path = `/${language}/`;
  } else {
    path = currentPath.replace(new RegExp(`^/${lang}(?=/|$)`), `/${language}`);
    if (!path.startsWith(`/${language}`)) {
      path = `/${language}${currentPath}`;
    }
  }
  if (!path.endsWith('/')) {
    path = `${path}/`;
  }
  return {
    lang: language,
    href: `${SITE_URL}${path}`,
  };
});

const xDefault = isRoot
  ? `${SITE_URL}/en/`
  : translatedAlternates.find((item) => item.lang === 'en')?.href || `${SITE_URL}/en/`;

// Structured Data Schemas
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description,
  inLanguage: lang,
};

const applicationSchema = webApplication
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      url: cleanCanonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires modern web browser with JavaScript enabled',
      isAccessibleForFree: true,
      inLanguage: lang,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    }
  : null;

const breadcrumbsSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: crumb.name,
          item: crumb.url.startsWith('http') ? crumb.url : `${SITE_URL}${crumb.url}`,
        })),
      }
    : null;

const faqSchema =
  faqItems && faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article.title,
      description: article.description,
      datePublished: article.publishDate,
      inLanguage: lang,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': cleanCanonical,
      },
      author: {
        '@type': 'Organization',
        name: SITE_NAME,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        url: SITE_URL,
      },
    }
  : null;
---

<!doctype html>
<html lang={lang} dir={locale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="QYadnpR-zqV0v5eyf2IsFG-DbYOMsXPgLvbsjwi-FuE" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}
    />

    <link rel="canonical" href={cleanCanonical} />
    <meta name="theme-color" content="#070812" />
    <meta name="application-name" content={SITE_NAME} />

    <!-- OpenGraph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Reciprocal Hreflang Tags -->
    {
      translatedAlternates.map((item) => (
        <link rel="alternate" hreflang={item.lang} href={item.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {applicationSchema && <script type="application/ld+json" set:html={JSON.stringify(applicationSchema)} />}
    {breadcrumbsSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`/${lang}/`} aria-label={`${SITE_NAME} home`}>
          <span class="brand-icon">T</span>
          <span>
            Tool<span class="brand-muted">Atlas</span>
          </span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href={`/${lang}/tools/`}>{locale.tools}</a>
          <a href={`/${lang}/categories/`}>{locale.categories}</a>
          <a href={`/${lang}/guides/`}>{locale.guides}</a>
          <a href={`/${lang}/about/`}>{locale.about}</a>
        </nav>

        <div class="header-actions">
          <label class="sr-only" for="language-selector">Language</label>
          <select
            id="language-selector"
            aria-label="Language selector"
            onchange="
              const target = this.value;
              const path = window.location.pathname;
              const parts = path.split('/').filter(Boolean);
              if (parts.length > 0) {
                parts[0] = target;
                window.location.href = '/' + parts.join('/') + '/';
              } else {
                window.location.href = '/' + target + '/';
              }
            "
          >
            {
              LANGUAGES.map((language) => (
                <option value={language} selected={language === lang}>
                  {language.toUpperCase()}
                </option>
              ))
            }
          </select>

          <a class="header-button" href={`/${lang}/tools/`}>
            {locale.exploreTools}
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-info">
          <div class="footer-brand">
            <span class="brand-icon small">T</span>
            <strong>{SITE_NAME}</strong>
          </div>
          <p>
            Fast, privacy-first online tools for everyday productivity, development, and conversion.
            All processing executes directly inside your browser memory without cloud file uploads.
          </p>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href={`/${lang}/tools/`}>{locale.tools}</a>
          <a href={`/${lang}/categories/`}>{locale.categories}</a>
          <a href={`/${lang}/guides/`}>{locale.guides}</a>
          <a href={`/${lang}/about/`}>{locale.about}</a>
          <a href={`/${lang}/privacy/`}>{locale.privacy}</a>
          <a href={`/${lang}/terms/`}>{locale.terms}</a>
          <a href={`/${lang}/contact/`}>{locale.contact}</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</span>
        <span>Privacy-first, client-side digital utility platform.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(7, 8, 18, 0.92);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(1180px, calc(100% - 32px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    text-decoration: none;
    font-size: 21px;
    font-weight: 900;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .brand-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(135deg, #22d3ee, #6366f1, #a855f7);
    color: #ffffff;
    font-weight: 900;
    box-shadow: 0 0 22px rgba(34, 211, 238, 0.28);
  }

  .brand-icon.small {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-size: 13px;
  }

  .brand-muted {
    color: #94a3b8;
  }

  .main-nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .main-nav a,
  .footer-links a {
    color: #aab4c5;
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
    transition: color 0.2s ease;
  }

  .main-nav a:hover,
  .footer-links a:hover {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #language-selector {
    min-height: 38px;
    padding: 0 10px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    outline: none;
    cursor: pointer;
  }

  .header-button {
    min-height: 38px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(34, 211, 238, 0.18);
  }

  .site-footer {
    margin-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(4, 5, 12, 0.95);
  }

  .footer-inner {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 48px 0 32px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-info {
    max-width: 480px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    color: #ffffff;
  }

  .footer-info p {
    margin: 14px 0 0;
    color: #8792a5;
    line-height: 1.7;
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-bottom {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #667085;
    font-size: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: auto;
      padding: 13px 0;
      flex-wrap: wrap;
      gap: 14px;
    }

    .main-nav {
      order: 3;
      width: 100%;
      justify-content: center;
      gap: 18px;
      padding-bottom: 3px;
    }

    .header-actions {
      margin-left: auto;
    }

    .header-button {
      display: none;
    }

    .footer-inner {
      flex-direction: column;
      padding-top: 34px;
    }

    .footer-links {
      gap: 16px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 7px;
    }
  }

  @media (max-width: 430px) {
    .header-inner,
    .footer-inner,
    .footer-bottom {
      width: calc(100% - 22px);
    }

    .brand {
      font-size: 19px;
    }

    .brand-icon {
      width: 31px;
      height: 31px;
    }

    .main-nav {
      gap: 15px;
    }

    .main-nav a {
      font-size: 13px;
    }
  }
</style>
