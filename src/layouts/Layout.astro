import '../styles/global.css';

const siteUrl = 'https://global-tools.hejajj96.workers.dev';

const {
  title,
  description,
  lang = 'en',
  canonical = `${siteUrl}/${lang}/`,
  noindex = false,
  alternates = [],
  breadcrumbs = [],
  webApplication = false
} = Astro.props;

const langs = [
  'en',
  'es',
  'fr',
  'de',
  'it',
  'pt',
  'ar',
  'tr',
  'hi',
  'ja'
];

const cleanUrl = (url: string) =>
  url
    .replace('https://global-tools.pages.dev', siteUrl)
    .replace('https://YOUR-DOMAIN.com', siteUrl)
    .replace(/([^:]\/)\/+/g, '$1');

const cleanCanonical = cleanUrl(canonical);

const currentPath = new URL(cleanCanonical).pathname;

const generatedAlternates = langs.map((language) => ({
  lang: language,
  href: cleanUrl(
    currentPath.replace(
      new RegExp(`^/${lang}(?=/|$)`),
      `/${language}`
    )
  )
}));

const finalAlternates =
  alternates.length > 0
    ? alternates.map((a: any) => ({
        lang: a.lang,
        href: cleanUrl(a.href)
      }))
    : generatedAlternates;

const xDefault =
  finalAlternates.find((a: any) => a.lang === 'en')?.href ||
  cleanUrl(
    currentPath.replace(
      new RegExp(`^/${lang}(?=/|$)`),
      '/en'
    )
  );

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolAtlas',
  url: siteUrl,
  description,
  inLanguage: lang
};

const applicationSchema = webApplication
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      url: cleanCanonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements:
        'Requires a modern web browser',
      isAccessibleForFree: true,
      inLanguage: lang
    }
  : null;

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map(
          (item: any, index: number) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: cleanUrl(item.url)
          })
        )
      }
    : null;

const schemas = [
  websiteSchema,
  ...(applicationSchema ? [applicationSchema] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : [])
];
