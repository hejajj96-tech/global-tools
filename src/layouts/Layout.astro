import '../styles/global.css';

const siteUrl = 'https://global-tools.hejajj96.workers.dev';

const {
  title,
  description,
  lang = 'en',
  canonical = `${siteUrl}/${lang}/`,
  noindex = false,
  alternates = [],
  breadcrumbs = [],
  webApplication = false
} = Astro.props;

const langs = [
  'en',
  'es',
  'fr',
  'de',
  'it',
  'pt',
  'ar',
  'tr',
  'hi',
  'ja'
];

const cleanUrl = (url: string) =>
  url
    .replace('https://global-tools.pages.dev', siteUrl)
    .replace('https://YOUR-DOMAIN.com', siteUrl)
    .replace(/([^:]\/)\/+/g, '$1');

const cleanCanonical = cleanUrl(canonical);

const currentPath = new URL(cleanCanonical).pathname;

const generatedAlternates = langs.map((language) => ({
  lang: language,
  href: cleanUrl(
    currentPath.replace(
      new RegExp(`^/${lang}(?=/|$)`),
      `/${language}`
    )
  )
}));

const finalAlternates =
  alternates.length > 0
    ? alternates.map((a: any) => ({
        lang: a.lang,
        href: cleanUrl(a.href)
      }))
    : generatedAlternates;

const xDefault =
  finalAlternates.find((a: any) => a.lang === 'en')?.href ||
  cleanUrl(
    currentPath.replace(
      new RegExp(`^/${lang}(?=/|$)`),
      '/en'
    )
  );

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolAtlas',
  url: siteUrl,
  description,
  inLanguage: lang
};

const applicationSchema = webApplication
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      url: cleanCanonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements:
        'Requires a modern web browser',
      isAccessibleForFree: true,
      inLanguage: lang
    }
  : null;

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map(
          (item: any, index: number) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: cleanUrl(item.url)
          })
        )
      }
    : null;

const schemas = [
  websiteSchema,
  ...(applicationSchema ? [applicationSchema] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : [])
];
---

<!doctype html>
<html
  lang={lang}
  dir={lang === 'ar' ? 'rtl' : 'ltr'}
>
  <head>
    <meta charset="UTF-8" />

    <!-- Google Search Console verification -->
    <meta
      name="google-site-verification"
      content="QYadnpR-zqV0v5eyf2IsFG-DbYOMsXPgLvbsjwi-FuE"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={cleanCanonical}
    />

    <meta
      name="robots"
      content={
        noindex
          ? 'noindex,follow'
          : 'index,follow,max-image-preview:large'
      }
    />

    <meta
      name="theme-color"
      content="#080b12"
    />

    <meta
      name="application-name"
      content="ToolAtlas"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={cleanCanonical}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="ToolAtlas"
    />

    <meta
      property="og:locale"
      content={lang}
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <link
      rel="icon"
      href="data:,"
    />

    {finalAlternates.map((a: any) => (
      <link
        rel="alternate"
        hreflang={a.lang}
        href={a.href}
      />
    ))}

    <link
      rel="alternate"
      hreflang="x-default"
      href={xDefault}
    />

    {schemas.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    ))}
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a
          href={`/${lang}/`}
          class="brand"
          aria-label="ToolAtlas home"
        >
          <span class="brand-mark">T</span>
          <span>
            Tool<span class="brand-muted">Atlas</span>
          </span>
        </a>

        <nav
          class="main-nav"
          aria-label="Main navigation"
        >
          <a href={`/${lang}/tools/`}>
            Tools
          </a>

          <a href={`/${lang}/categories/`}>
            Categories
          </a>

          <a href={`/${lang}/about/`}>
            About
          </a>
        </nav>

        <div class="header-actions">
          <label
            for="language-selector"
            class="sr-only"
          >
            Language
          </label>

          <select
            id="language-selector"
            aria-label="Language"
            onchange="
              const target = this.value;
              const current = window.location.pathname;
              const translated = current.replace(
                /^\/[^/]+/,
                '/' + target
              );
              window.location.href =
                translated.endsWith('/')
                  ? translated
                  : translated + '/';
            "
          >
            <option
              value={lang}
              selected
            >
              {lang.toUpperCase()}
            </option>

            {langs
              .filter((language) => language !== lang)
              .map((language) => (
                <option value={language}>
                  {language.toUpperCase()}
                </option>
              ))}
          </select>

          <a
            class="header-cta"
            href={`/${lang}/tools/`}
          >
            Explore tools
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <span class="brand-mark small">T</span>
            <strong>ToolAtlas</strong>
          </div>

          <p>
            Fast, privacy-first online tools for everyday work.
            Built to process data locally whenever technically possible.
          </p>
        </div>

        <nav
          class="footer-nav"
          aria-label="Footer navigation"
        >
          <a href={`/${lang}/tools/`}>
            Tools
          </a>

          <a href={`/${lang}/privacy/`}>
            Privacy
          </a>

          <a href={`/${lang}/terms/`}>
            Terms
          </a>

          <a href={`/${lang}/contact/`}>
            Contact
          </a>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} ToolAtlas
        </span>

        <span>
          Free online tools
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
